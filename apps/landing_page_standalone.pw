               "  <div class='row btn-group'>" +
               "    <button class='btn btn-primary'>Explore Architecture [>]</button>" +
               "    <button class='btn btn-secondary'>JSON Features API [*]</button>" +
               "  </div>" +
               "</div>" +
               "<div class='row stats-bar'>" +
               "  <div class='stat-card'>" +
               "    <h2 class='stat-num'>2,048 B</h2>" +
               "    <p class='stat-label'>HELLO BINARY SIZE</p>" +
               "  </div>" +
               "  <div class='stat-card'>" +
               "    <h2 class='stat-num'>sub-5 ms</h2>" +
               "    <p class='stat-label'>IN-RAM JIT EXECUTION</p>" +
               "  </div>" +
               "  <div class='stat-card'>" +
               "    <h2 class='stat-num'>0 KB</h2>" +
               "    <p class='stat-label'>GARBAGE COLLECTOR OVERHEAD</p>" +
               "  </div>" +
               "  <div class='stat-card'>" +
               "    <h2 class='stat-num'>126/126</h2>" +
               "    <p class='stat-label'>IRONCLAD TEST SUITE</p>" +
               "  </div>" +
               "</div>" +
               "<div class='row grid'>" +
               "  <div class='card'>" +
               "    <h2>Sub-5ms In-RAM JIT</h2>" +
