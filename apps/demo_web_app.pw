// apps/demo_web_app.pw — Interactive Full-Stack Web & REST API Application in Pure Purwa
// Pure Purwa, zero external dependencies.
// Express/FastAPI-like REST API + Glassmorphism Dark UI.

import "web"

main() do
    app = web_app()
    web_enable_cors(app)
    web_enable_logger(app)

    // Register routes
    web_get(app, "/", 1)
    web_get(app, "/api/status", 2)
    web_get(app, "/api/tasks", 3)
    web_get(app, "/api/tasks/:id", 4)
    web_post(app, "/api/tasks", 5)

    show("=================================================================\n")
    show("     PURWA FULL-STACK WEB APPLICATION & REST API FRAMEWORK       \n")
    show("=================================================================\n\n")
    show("Registered Endpoints:\n")
    show("  • GET  /              -> Glassmorphism Web Dashboard\n")
    show("  • GET  /api/status    -> System Health & Performance JSON\n")
    show("  • GET  /api/tasks     -> Task Collection JSON\n")
    show("  • GET  /api/tasks/:id -> Parametric Task Lookup\n")
    show("  • POST /api/tasks     -> Create Task Resource\n\n")

    // In a live environment, call: web_listen(app, 3000)
    // For fast smoke verification:
    show("[Web App] Initialized successfully. Ready to bind on port 3000.\n")
    0
end
