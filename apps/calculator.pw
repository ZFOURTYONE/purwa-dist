// ============================================================
// Purwa Calculator — a real desktop app, zero dependencies.
//
// A modern dark-theme calculator rendered with a pure-software
// rasterizer (lib/canvas) onto a native Win32 window (lib/gui).
// Includes its own 5x7 bitmap font (23 glyphs), rounded-corner
// widgets, hover/press states, and fixed-point i64 arithmetic
// (scale 1000 = 3 decimals — no float rounding surprises).
//
// run      : purwac apps/calculator.pw -o calc.exe && calc.exe
// selftest : purwac apps/calculator.pw --selftest   (exit 0 = pass)
//
// keyboard : Esc quits. Everything else is mouse-driven.
// ============================================================

import "canvas"
import "gui"

// ---------------- palette ----------------
const COL_BG_R = 15
const COL_BG_G = 23
const COL_BG_B = 42

const COL_DIGIT_FILL_R = 32
const COL_DIGIT_FILL_G = 41
const COL_DIGIT_FILL_B = 59
const COL_DIGIT_HOVER_R = 49
const COL_DIGIT_HOVER_G = 62
const COL_DIGIT_HOVER_B = 88

const COL_FN_TEXT_R = 148
const COL_FN_TEXT_G = 163
const COL_FN_TEXT_B = 184

const COL_OP_R = 2
const COL_OP_G = 132
const COL_OP_B = 199
const COL_OP_HOVER_R = 56
const COL_OP_HOVER_G = 160
const COL_OP_HOVER_B = 235

const COL_EQ_R = 245
const COL_EQ_G = 158
const COL_EQ_B = 11
const COL_EQ_HOVER_R = 251
const COL_EQ_HOVER_G = 186
const COL_EQ_HOVER_B = 40

const COL_TXT_R = 240
const COL_TXT_G = 244
const COL_TXT_B = 250
const COL_MUT_R = 100
const COL_MUT_G = 116
const COL_MUT_B = 139

// ---------------- layout ----------------
const W = 380
const H = 544
const M = 16
const GAP = 12
const BW = 78
const BH = 58
const GY = 176
const SCALE_S = 1000

// ---------------- font: 23 glyphs, 5x7, MSB = left column ----------
global FONT_ROWS = 0

init_font() do
    FONT_ROWS = [
        [14, 17, 19, 21, 25, 17, 14],
        [4, 12, 4, 4, 4, 4, 14],
        [14, 17, 1, 2, 4, 8, 31],
        [31, 2, 4, 2, 1, 17, 14],
        [2, 6, 10, 18, 31, 2, 2],
        [31, 16, 30, 1, 1, 17, 14],
        [6, 8, 16, 30, 17, 17, 14],
        [31, 1, 2, 4, 8, 8, 8],
        [14, 17, 17, 14, 17, 17, 14],
        [14, 17, 17, 15, 1, 2, 12],
        [0, 4, 4, 31, 4, 4, 0],
        [0, 0, 0, 31, 0, 0, 0],
        [0, 17, 10, 4, 10, 17, 0],
        [4, 0, 31, 0, 4, 0, 0],
        [0, 0, 31, 0, 31, 0, 0],
        [0, 0, 0, 0, 0, 12, 12],
        [24, 25, 2, 4, 8, 19, 3],
        [14, 17, 16, 16, 16, 17, 14],
        [31, 16, 30, 16, 16, 16, 31],
        [14, 17, 17, 17, 17, 17, 14],
        [30, 17, 17, 30, 20, 18, 17],
        [4, 4, 31, 4, 0, 14, 0],
        [4, 8, 31, 8, 4, 0, 0]
    ]
    0
end

pw2(n) do
    p = 1
    i = 0
    while i < n do
        p = p * 2
        i += 1
    end
    p
end

pw10(n) do
    p = 1
    i = 0
    while i < n do
        p = p * 10
        i += 1
    end
    p
end

glyph_index(code) do
    gi = 11
    if code >= 48 and code <= 57 do
        gi = code - 48
    else do
        gi = match code do
            43  => 10
            45  => 11
            42  => 12
            47  => 13
            61  => 14
            46  => 15
            37  => 16
            67  => 17
            69  => 18
            79  => 19
            82  => 20
            200 => 21
            201 => 22
            _   => 11
        end
    end
    gi
end

draw_glyph(c: Canvas, code, x, y, sc, r, g, b) do
    rows = FONT_ROWS[glyph_index(code)]
    ry = 0
    while ry < 7 do
        bits = rows[ry]
        cx = 0
        while cx < 5 do
            mask = 16 / pw2(cx)
            if bits - (bits / (mask * 2)) * (mask * 2) >= mask do
                canvas_fill_rect(c, x + cx * sc, y + ry * sc, sc, sc, r, g, b, 255)
            end
            cx += 1
        end
        ry += 1
    end
    0
end

text_w(len, sc) do
    len * 6 * sc - sc
end

draw_text(c: Canvas, arr, len, x, y, sc, r, g, b) do
    i = 0
    while i < len do
        draw_glyph(c, arr[i], x + i * 6 * sc, y, sc, r, g, b)
        i += 1
    end
    0
end

draw_text_right(c: Canvas, arr, len, right_x, y, sc, r, g, b) do
    draw_text(c, arr, len, right_x - text_w(len, sc), y, sc, r, g, b)
    0
end

// rounded corners: four scanline-span quarter discs around a cross fill
round_rect(c: Canvas, x, y, w, h, rad, fr, fg, fb) do
    canvas_fill_rect(c, x + rad, y, w - 2 * rad, h, fr, fg, fb, 255)
    canvas_fill_rect(c, x, y + rad, rad, h - 2 * rad, fr, fg, fb, 255)
    canvas_fill_rect(c, x + w - rad, y + rad, rad, h - 2 * rad, fr, fg, fb, 255)
    dy = 0
    while dy < rad do
        dx = 0
        span = 0 - 1
        while dx < rad do
            if dx * dx + dy * dy <= rad * rad then span = dx
            dx += 1
        end
        if span >= 0 do
            yy = y + dy
            canvas_fill_rect(c, x + rad - span - 1, yy, span + 1, 1, fr, fg, fb, 255)
            canvas_fill_rect(c, x + w - rad, yy, span + 1, 1, fr, fg, fb, 255)
            yy2 = y + h - 1 - dy
            canvas_fill_rect(c, x + rad - span - 1, yy2, span + 1, 1, fr, fg, fb, 255)
            canvas_fill_rect(c, x + w - rad, yy2, span + 1, 1, fr, fg, fb, 255)
        end
        dy += 1
    end
    0
end

round_btn(c: Canvas, x, y, w, h, br_r, br_g, br_b, fi_r, fi_g, fi_b) do
    round_rect(c, x, y, w, h, 14, br_r, br_g, br_b)
    round_rect(c, x + 1, y + 1, w - 2, h - 2, 13, fi_r, fi_g, fi_b)
    0
end

hit(mx, my, x, y, w, h) do
    if mx >= x and mx < x + w and my >= y and my < y + h then true else false
end

// ---------------- calculator state (fixed-point, scale 1000) -------
global g_acc = 0
global g_op = 0
global g_fresh = 1
global g_error = 0
global g_el = 0
global g_nd = 0
global g_hl = 0
global g_ent = 0
global g_hist = 0
global g_tmp = 0
global g_scr = 0
global g_errbuf = 0
global g_shot = 0

init_state() do
    g_acc = 0
    g_op = 0
    g_fresh = 1
    g_error = 0
    g_el = 0
    g_nd = 0
    g_hl = 0
    0
end

ent_clear() do
    g_el = 0
    g_nd = 0
    0
end

ent_push(ch, is_digit) do
    if g_el < 22 do
        g_ent[g_el] = ch
        g_el += 1
        if is_digit then g_nd += 1
    end
    0
end

ent_backspace() do
    if g_el > 0 do
        last = g_ent[g_el - 1]
        if last >= 48 and last <= 57 then g_nd -= 1
        g_el -= 1
    end
    0
end

count_digits() do
    n = 0
    i = 0
    while i < g_el do
        ch = g_ent[i]
        if ch >= 48 and ch <= 57 then n += 1
        i += 1
    end
    n
end

// materialize current accumulator into the entry buffer for editing
entry_from_acc() do
    cnt = fx_to_chars(g_acc, g_tmp)
    j = 0
    while j < cnt do
        g_ent[j] = g_tmp[j]
        j += 1
    end
    g_el = cnt
    g_nd = count_digits()
    g_fresh = 0
    0
end

// entry chars -> fixed-point value (scale 1000)
entry_to_fx() do
    i = 0
    sign = 1
    if g_el > 0 do
        if g_ent[0] == 45 do
            sign = 0 - 1
            i = 1
        end
    end
    ip = 0
    fp = 0
    dec = 0
    seen_dot = 0
    while i < g_el do
        ch = g_ent[i]
        if ch == 46 do
            seen_dot = 1
        else do
            d = ch - 48
            if seen_dot == 0 do
                ip = ip * 10 + d
            else do
                if dec < 3 do
                    fp = fp * 10 + d
                    dec += 1
                end
            end
        end
        i += 1
    end
    sign * (ip * SCALE_S + fp * pw10(3 - dec))
end

// fixed-point -> char codes into buf; uses g_scr internally
fx_to_chars(v, buf) do
    neg = 0
    a = v
    if v < 0 do
        neg = 1
        a = 0 - v
    end
    ip = a / SCALE_S
    fp = a - ip * SCALE_S
    len = 0
    if neg == 1 do
        buf[0] = 45
        len = 1
    end
    n = 0
    if ip == 0 do
        g_scr[0] = 48
        n = 1
    else do
        while ip > 0 do
            g_scr[n] = 48 + ip - (ip / 10) * 10
            n += 1
            ip = ip / 10
        end
    end
    k = 0
    while k < n do
        buf[len + k] = g_scr[n - 1 - k]
        k += 1
    end
    len += n
    if fp > 0 do
        buf[len] = 46
        len += 1
        buf[len] = 48 + fp / 100
        len += 1
        buf[len] = 48 + (fp / 10) - (fp / 100) * 10
        len += 1
        buf[len] = 48 + fp - (fp / 10) * 10
        len += 1
        while buf[len - 1] == 48 do
            len -= 1
        end
    end
    len
end

set_hist_acc() do
    g_hl = fx_to_chars(g_acc, g_hist)
    0
end

hist_append_value(v) do
    g_hl += fx_to_chars(v, g_hist + g_hl)
    0
end

hist_append_code(code) do
    if g_hl < 38 do
        g_hist[g_hl] = code
        g_hl += 1
    end
    0
end

current_value() do
    if g_el > 0 then entry_to_fx() else g_acc
end

// core arithmetic; raises g_error instead of crashing
apply_op(a, op, b) do
    r = 0
    if op == 1 do
        r = a + b
    else if op == 2 do
        r = a - b
    else if op == 3 do
        // overflow gate BEFORE multiplying: |int(a)|*|int(b)| <= 9e12
        // keeps every split term inside i64 range
        ia = a / SCALE_S
        ib = b / SCALE_S
        aa = if ia < 0 then 0 - ia else ia
        ab = if ib < 0 then 0 - ib else ib
        if aa * ab > 9000000000000 do
            g_error = 1
            r = 0
        else do
            ra = a - ia * SCALE_S
            rb = b - ib * SCALE_S
            t1 = ia * ib * SCALE_S
            t2 = ia * rb + ra * ib
            t3 = (ra * rb) / SCALE_S
            r = t1 + t2 + t3
        end
    else if op == 4 do
        if b == 0 do
            g_error = 1
            r = 0
        else do
            r = (a * SCALE_S) / b
        end
    end
    r
end

press_digit(d) do
    if g_error == 1 then init_state()
    if g_fresh == 1 do
        ent_clear()
        g_fresh = 0
    end
    if g_nd < 9 then ent_push(48 + d, 1)
    0
end

press_dot() do
    if g_error == 1 then init_state()
    if g_fresh == 1 do
        ent_clear()
        g_fresh = 0
    end
    has_dot = false
    i = 0
    while i < g_el do
        if g_ent[i] == 46 then has_dot = true
        i += 1
    end
    if not has_dot do
        if g_el == 0 then ent_push(48, 1)
        ent_push(46, 0)
    end
    0
end

press_pm() do
    if g_error == 0 and g_el == 0 and g_acc != 0 then entry_from_acc()
    if g_error == 0 and g_el > 0 do
        if g_ent[0] == 45 do
            k = 1
            while k < g_el do
                g_ent[k - 1] = g_ent[k]
                k += 1
            end
            g_el -= 1
        else do
            if g_el < 22 do
                k2 = g_el
                while k2 > 0 do
                    g_ent[k2] = g_ent[k2 - 1]
                    k2 -= 1
                end
                g_ent[0] = 45
                g_el += 1
            end
        end
    end
    0
end

press_pct() do
    if g_error == 0 and g_el > 0 do
        v = entry_to_fx() / 100
        ent_clear()
        cnt = fx_to_chars(v, g_tmp)
        j = 0
        while j < cnt do
            g_ent[j] = g_tmp[j]
            j += 1
        end
        g_el = cnt
        g_nd = count_digits()
        g_fresh = 0
    end
    0
end

press_c() do
    init_state()
    0
end

press_del() do
    if g_error == 0 do
        if g_fresh == 1 do
            init_state()
        else do
            ent_backspace()
        end
    end
    0
end

press_op(op) do
    if g_error == 0 do
        cur = current_value()
        if g_op == 0 do
            g_acc = cur
        else do
            if g_fresh == 0 do
                g_acc = apply_op(g_acc, g_op, cur)
            end
        end
        if g_error == 0 do
            g_op = op
            g_fresh = 1
            ent_clear()
            opc = 43
            if op == 2 then opc = 45
            if op == 3 then opc = 42
            if op == 4 then opc = 47
            set_hist_acc()
            hist_append_code(opc)
        end
    end
    0
end

press_eq() do
    if g_error == 0 and g_op != 0 do
        cur = current_value()
        if g_fresh == 0 do
            set_hist_acc()
            opc = 43
            if g_op == 2 then opc = 45
            if g_op == 3 then opc = 42
            if g_op == 4 then opc = 47
            hist_append_code(opc)
            hist_append_value(cur)
            hist_append_code(61)
            g_acc = apply_op(g_acc, g_op, cur)
        else do
            set_hist_acc()
            hist_append_code(61)
        end
        if g_error == 0 do
            g_op = 0
            ent_clear()
            g_fresh = 1
        end
    end
    0
end

// ---------------- grid geometry ------------------------------------
cell_x(col) do
    M + col * (BW + GAP)
end

cell_y(row) do
    GY + row * (BH + GAP)
end

// style: 0 digit, 1 fn, 2 operator, 3 equals
cell_label(row, col) do
    v = 48
    if row == 0 do
        v = match col do 0 => 67 1 => 200 2 => 37 _ => 47 end
    end
    if row == 1 do
        v = match col do 0 => 55 1 => 56 2 => 57 _ => 42 end
    end
    if row == 2 do
        v = match col do 0 => 52 1 => 53 2 => 54 _ => 45 end
    end
    if row == 3 do
        v = match col do 0 => 49 1 => 50 2 => 51 _ => 43 end
    end
    if row == 4 do
        v = 61
        if col == 0 then v = 48
        if col == 2 then v = 46
    end
    v
end

cell_style(row, col) do
    s = 0
    if row == 0 then s = 1
    if col == 3 then s = 2
    if row == 4 and col == 3 then s = 3
    s
end

// packed actions: 1..10 digit d=a-1, 20 dot, 21 pm, 22 pct, 23 c,
// 24 del, 31 add, 32 sub, 33 mul, 34 div, 40 eq
cell_action(row, col) do
    a = 1 + (cell_label(row, col) - 48)
    if row == 0 do
        a = match col do 0 => 23 1 => 21 2 => 22 _ => 34 end
    end
    if row == 1 and col == 3 then a = 33
    if row == 2 and col == 3 then a = 32
    if row == 3 and col == 3 then a = 31
    if row == 4 do
        a = 40
        if col == 0 then a = 1
        if col == 2 then a = 20
    end
    a
end

do_action(a) do
    if a <= 19 do
        press_digit(a - 1)
    else do
        match a do
            20 => press_dot()
            21 => press_pm()
            22 => press_pct()
            23 => press_c()
            24 => press_del()
            31 => press_op(1)
            32 => press_op(2)
            33 => press_op(3)
            34 => press_op(4)
            40 => press_eq()
            _   => 0
        end
    end
    0
end

draw_button(c: Canvas, x, y, bw, code, style, mx, my, down) do
    hov = hit(mx, my, x, y, bw, BH)
    held = if hov == 1 and down == 1 then true else false
    fi_r = COL_DIGIT_FILL_R
    fi_g = COL_DIGIT_FILL_G
    fi_b = COL_DIGIT_FILL_B
    tx_r = COL_TXT_R
    tx_g = COL_TXT_G
    tx_b = COL_TXT_B
    bo_r = 58
    bo_g = 70
    bo_b = 90
    if style == 1 do
        fi_r = 27
        fi_g = 35
        fi_b = 52
        tx_r = COL_FN_TEXT_R
        tx_g = COL_FN_TEXT_G
        tx_b = COL_FN_TEXT_B
    end
    if style == 2 do
        fi_r = COL_OP_R
        fi_g = COL_OP_G
        fi_b = COL_OP_B
        bo_r = 30
        bo_g = 150
        bo_b = 215
    end
    if style == 3 do
        fi_r = COL_EQ_R
        fi_g = COL_EQ_G
        fi_b = COL_EQ_B
        bo_r = 255
        bo_g = 190
        bo_b = 60
    end
    if hov == 1 do
        if style == 0 do
            fi_r = COL_DIGIT_HOVER_R
            fi_g = COL_DIGIT_HOVER_G
            fi_b = COL_DIGIT_HOVER_B
        end
        if style == 1 do
            fi_r = 38
            fi_g = 48
            fi_b = 68
        end
        if style == 2 do
            fi_r = COL_OP_HOVER_R
            fi_g = COL_OP_HOVER_G
            fi_b = COL_OP_HOVER_B
        end
        if style == 3 do
            fi_r = COL_EQ_HOVER_R
            fi_g = COL_EQ_HOVER_G
            fi_b = COL_EQ_HOVER_B
        end
    end
    if held == 1 do
        fi_r = fi_r + 18
        fi_g = fi_g + 18
        fi_b = fi_b + 18
    end
    round_btn(c, x, y, bw, BH, bo_r, bo_g, bo_b, fi_r, fi_g, fi_b)
    gx = x + (bw - text_w(1, 3)) / 2
    gy = y + (BH - 21) / 2
    draw_glyph(c, code, gx, gy, 3, tx_r, tx_g, tx_b)
    0
end

render_all(c: Canvas, mx, my, down) do
    canvas_clear(c, COL_BG_R, COL_BG_G, COL_BG_B, 255)

    // decorative traffic dots
    canvas_fill_circle(c, 30, 26, 6, 255, 95, 86, 255)
    canvas_fill_circle(c, 54, 26, 6, 255, 189, 46, 255)
    canvas_fill_circle(c, 78, 26, 6, 39, 201, 63, 255)

    // history line
    if g_hl > 0 do
        draw_text_right(c, g_hist, g_hl, W - M, 44, 2, COL_MUT_R, COL_MUT_G, COL_MUT_B)
    end

    // main display line
    if g_error == 1 do
        draw_text_right(c, g_errbuf, 5, W - M, 96, 6, 248, 113, 113)
    else do
        vlen = 0
        if g_el > 0 do
            j = 0
            while j < g_el do
                g_tmp[j] = g_ent[j]
                j += 1
            end
            vlen = g_el
        else do
            vlen = fx_to_chars(g_acc, g_tmp)
        end
        dim = 6
        if vlen > 10 then dim = 5
        draw_text_right(c, g_tmp, vlen, W - M, 138 - 7 * dim, dim, COL_TXT_R, COL_TXT_G, COL_TXT_B)
    end

    // accent underline below the display
    canvas_fill_rect(c, M, 156, W - 2 * M, 3, 30, 90, 140, 255)

    // button grid
    row = 0
    while row < 5 do
        col = 0
        while col < 4 do
            skip = 0
            bw = BW
            if row == 4 and col == 1 then skip = 1
            if row == 4 and col == 0 then bw = 2 * BW + GAP
            if skip == 0 do
                draw_button(c, cell_x(col), cell_y(row), bw, cell_label(row, col), cell_style(row, col), mx, my, down)
            end
            col += 1
        end
        row += 1
    end
    0
end

click_at(x, y) do
    row = 0
    done = false
    while row < 5 and not done do
        col = 0
        while col < 4 and not done do
            skip = 0
            bw = BW
            if row == 4 and col == 1 then skip = 1
            if row == 4 and col == 0 then bw = 2 * BW + GAP
            if skip == 0 do
                if hit(x, y, cell_x(col), cell_y(row), bw, BH) == 1 do
                    do_action(cell_action(row, col))
                    done = true
                end
            end
            col += 1
        end
        row += 1
    end
    0
end

// ---------------- selftest: gated claims about the logic -----------
expect(tid, flag) do
    if flag == 0 do
        show("FAIL test ")
        show_num(tid)
        show("\n")
    end
    flag
end

run_selftest() do
    fails = 0

    t = fx_to_chars(1234500, g_tmp)
    if expect(1, t == 6) == 0 then fails += 1
    if expect(2, g_tmp[4] == 46 and g_tmp[5] == 53) == 0 then fails += 1
    t = fx_to_chars(0 - 500, g_tmp)
    if expect(3, t == 4 and g_tmp[0] == 45 and g_tmp[3] == 53) == 0 then fails += 1

    g_el = 0
    ent_push(49, 1)
    ent_push(50, 1)
    ent_push(46, 0)
    ent_push(51, 1)
    ent_push(52, 1)
    if expect(4, entry_to_fx() == 12340) == 0 then fails += 1

    // the float trap 0.1 + 0.2 solved exactly by fixed-point
    g_el = 0
    ent_push(48, 1)
    ent_push(46, 0)
    ent_push(49, 1)
    a = entry_to_fx()
    g_el = 0
    ent_push(48, 1)
    ent_push(46, 0)
    ent_push(50, 1)
    b = entry_to_fx()
    if expect(5, a + b == 300) == 0 then fails += 1
    t = fx_to_chars(a + b, g_tmp)
    if expect(6, t == 3 and g_tmp[0] == 48 and g_tmp[1] == 46 and g_tmp[2] == 51) == 0 then fails += 1

    if expect(7, apply_op(1500, 3, 2000) == 3000) == 0 then fails += 1
    if expect(8, apply_op(7000, 4, 2000) == 3500) == 0 then fails += 1

    g_error = 0
    r0 = apply_op(7000, 4, 0)
    if expect(9, g_error == 1 and r0 == 0) == 0 then fails += 1
    g_error = 0

    big = 999999999 * SCALE_S
    ro = apply_op(big, 3, big)
    if expect(10, g_error == 1) == 0 then fails += 1
    g_error = 0

    g_el = 0
    ent_push(53, 1)
    ent_push(48, 1)
    press_pct()
    if expect(11, entry_to_fx() == 500) == 0 then fails += 1

    press_pm()
    if expect(12, g_ent[0] == 45) == 0 then fails += 1
    press_pm()
    if expect(13, g_ent[0] != 45) == 0 then fails += 1

    init_state()
    press_digit(1)
    press_digit(2)
    press_op(1)
    press_digit(7)
    press_op(3)
    press_digit(3)
    press_eq()
    if expect(14, g_error == 0 and g_acc == 57000) == 0 then fails += 1

    init_state()
    d = 0
    while d < 15 do
        press_digit(9)
        d += 1
    end
    if expect(15, g_nd == 9) == 0 then fails += 1

    init_state()
    press_digit(5)
    press_op(1)
    press_digit(3)
    if expect(16, entry_to_fx() == 3000) == 0 then fails += 1

    fails
end

find_pattern(hay, pat, plen) do
    n = size_of(hay)
    found = false
    i = 0
    while i + plen <= n do
        ok = true
        j = 0
        while j < plen do
            if get_byte(hay, i + j) != get_byte(pat, j) then ok = false
            j += 1
        end
        if ok then found = true
        i += 1
    end
    found
end

run_gui() do
    win = gui_open_window("Purwa Calculator", W, H)
    // enforce exact client size regardless of WM defaults
    fn_move = get_fn(win.u32, "MoveWindow")
    call_dll(fn_move, win.hwnd, 120, 80, W + 16, H + 39, 1)
    cv = canvas_create(W, H)
    frame = 0
    running = true
    while running do
        if not gui_is_open(win) then running = false
        if gui_key_esc(win) != 0 then running = false
        if running do
            gui_poll_events(win)
            // single source of truth for clicks: message queue only.
            // (the old GetAsyncKeyState edge fallback fired on top of
            // WM_LBUTTONDOWN for real mice -> every click counted twice)
            while gui_click_pending(win) > 0 do
                (ccx, ccy) = gui_pop_click(win)
                click_at(ccx, ccy)
            end
            mx = gui_mouse_x(win)
            my = gui_mouse_y(win)
            down = gui_mouse_down(win)   // press visual state only
            if g_shot == 1 do
                // deterministic render dump: synthetic 7 x 8 = script
                frame += 1
                if frame == 5 then click_at(55, 275)
                if frame == 15 then click_at(325, 275)
                if frame == 25 then click_at(145, 275)
                if frame == 35 then click_at(325, 485)
            end
            render_all(cv, mx, my, down)
            gui_blit_canvas(win, cv)
            if g_shot == 1 do
                if frame == 50 do
                    canvas_save_bmp(cv, "calc_canvas.bmp")
                    running = false
                end
            end
            sleep(16)
        end
    end
    canvas_destroy(cv)
    gui_close_window(win)
    0
end

main() do
    init_font()
    g_ent = make_array(24, 0)
    g_hist = make_array(40, 0)
    g_tmp = make_array(32, 0)
    g_scr = make_array(32, 0)
    g_errbuf = [69, 82, 82, 79, 82]
    init_state()

    cmdline = args()
    rc = 0
    g_shot = 0
    if find_pattern(cmdline, "-shot", 5) == 1 then g_shot = 1
    if find_pattern(cmdline, "-selftest", 9) == 1 do
        // binary is GUI-subsystem (no console): attach one only when stdout
        // is not already valid (e.g. redirected pipe from CI keeps working)
        k32m = load_dll("kernel32.dll")
        fn_gsh = get_fn(k32m, "GetStdHandle")
        h_out = call_dll(fn_gsh, -11)   // STD_OUTPUT_HANDLE
        if h_out == 0 or h_out == -1 do
            fn_attc = get_fn(k32m, "AttachConsole")
            ok_att = call_dll(fn_attc, -1)   // ATTACH_PARENT_PROCESS
            if ok_att == 0 do
                fn_alc = get_fn(k32m, "AllocConsole")
                call_dll(fn_alc)
            end
        end
        fails = run_selftest()
        show("selftest complete, fails=")
        show_num(fails)
        show("\n")
        rc = fails
    else do
        rc = run_gui()
    end
    drop(g_ent)
    drop(g_hist)
    drop(g_tmp)
    drop(g_scr)
    rc
end
