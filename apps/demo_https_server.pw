// apps/demo_https_server.pw — Standalone Native HTTPS Web Server in Pure Purwa
// Pure Purwa, zero external dependencies (0-OpenSSL, 0-Nginx, 0-Cloudflare).
// Listens on port 8443, serves encrypted web pages and JSON APIs over TLS.

import "tls"
import "net"

main() do
    show("=================================================================\n")
    show("       PURWA SOVEREIGN STANDALONE HTTPS / TLS WEB SERVER        \n")
    show("=================================================================\n\n")

    port = 8443
    show($"Initializing TLS 1.2/1.3 Engine on port {port}...\n")
    
    server = tls_server_create(port, "")
    if server.server_fd < 0 do
        show($"Error: Failed to bind HTTPS server on port {port}\n")
        1
    else do
        show($"[HTTPS] Server listening on https://127.0.0.1:{port}/\n")
        show($"[HTTPS] Open in your browser: https://localhost:{port}/\n")
        show("[HTTPS] Press Ctrl+C to stop server.\n\n")

        // Non-blocking / 1 request demo mode or multi-request loop
        req_count = 0
        while req_count < 3 do
            show($"[HTTPS] Waiting for secure client connection #{req_count + 1}...\n")
            client = tls_server_accept(server)

            if client.raw_fd >= 0 do
                show("[HTTPS] Secure TLS connection established!\n")

                buf = alloc(4096)
                cleanup drop(buf)
                n = tls_recv(client, buf, 4000)

                if n > 0 do
                    show($"[HTTPS] Received request:\n---\n{buf}---\n")

                    html_body = "<!DOCTYPE html><html><head><title>Purwa Native HTTPS</title></head>" +
                                "<body style='font-family:sans-serif;background:#0f172a;color:#f8fafc;padding:2rem;'>" +
                                "<h1 style='color:#38bdf8;'>Purwa Native HTTPS Server 🚀🔒</h1>" +
                                "<p>Encrypted using sovereign Purwa TLS engine — 0 OpenSSL, 0 Nginx, 0 Cloudflare!</p>" +
                                "<div style='background:#1e293b;padding:1rem;border-radius:8px;'>" +
                                $"<code>Status: 200 OK | Port: {port} | TLS Handshake: Active</code>" +
                                "</div></body></html>"

                    resp = https_response_ok(html_body, "text/html; charset=utf-8")
                    tls_send(client, resp)
                    show("[HTTPS] Sent encrypted HTTPS 200 OK response.\n")
                end

                tls_close(client)
                req_count = req_count + 1
            end
        end

        show("[HTTPS] Server completed demo cycles. Closing.\n")
        0
    end
end
