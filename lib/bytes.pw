// lib/bytes.pw — low-level byte & integer helpers for raw memory buffers
// Memanfaatkan instruksi mesin CPU presisi tinggi untuk pembacaan memori:
//   read_u64 / write_u64 (8 byte little-endian, 1-instruksi CPU)
//   read_u32 / write_u32 (4 byte little-endian, 1-instruksi CPU)
//   read_u16 / write_u16 (2 byte little-endian, 1-instruksi CPU)
//   read_u8  / write_u8  (1 byte)

read_u8(p, off) do
    get_byte(p, off)
end

write_u8(p, off, v) do
    set_byte(p, off, v)
end

read_u16(p, off) do
    get_u16(p, off)
end

write_u16(p, off, v) do
    set_u16(p, off, v)
end

read_u32(p, off) do
    get_u32(p, off)
end

write_u32(p, off, v) do
    set_u32(p, off, v)
end

read_u64(p, off) do
    get_u64(p, off)
end

write_u64(p, off, v) do
    set_u64(p, off, v)
end

// Big-endian utilities
read_u16_be(p, off) do
    (get_byte(p, off) << 8) | get_byte(p, off + 1)
end

write_u16_be(p, off, v) do
    set_byte(p, off, (v >> 8) & 255)
    set_byte(p, off + 1, v & 255)
end

read_u32_be(p, off) do
    (get_byte(p, off) << 24) | (get_byte(p, off + 1) << 16) |
    (get_byte(p, off + 2) << 8) | get_byte(p, off + 3)
end

write_u32_be(p, off, v) do
    set_byte(p, off, (v >> 24) & 255)
    set_byte(p, off + 1, (v >> 16) & 255)
    set_byte(p, off + 2, (v >> 8) & 255)
    set_byte(p, off + 3, v & 255)
end
