// lib/sort.pw — Sorting & searching murni Purwa (v37.39)
// ===========================================================================
// Bekerja pada array inti Purwa (array literal / `alloc` dengan count di
// slot depan): size(a) + a[i] + a[i] = v. In-place, tanpa alokasi tambahan
// (kecuali argsort & dedup yang mengembalikan array baru).
//
// Isi:
//   sort_asc(a)          quicksort median-of-three + insertion utk segmen kecil
//   sort_desc(a)         urut menurun
//   sort_str(a)          urut array string (str_cmp)
//   argsort_asc(a)       kembalikan array INDEKS terurut (array baru)
//   dedup_sorted(a)      buang duplikat dari array terurut (array baru)
//   is_sorted(a)         1 bila naik ketat
//   binary_search(a, x)  indeks x pada array terurut, atau 0 - 1
//   binary_search_str(a, s)
//
// Catatan: comparator tidak bisa jadi parameter (function value internal
// belum tersedia di Purwa) — pakai varian fixed di atas.
// ===========================================================================

// _sort_swap(a, i, j): tukar dua slot
_sort_swap(a, i, j) do
    t = a[i]
    a[i] = a[j]
    a[j] = t
    0
end

// _sort_insert(a, lo, hi): insertion sort segmen [lo..hi] (naik)
_sort_insert(a, lo, hi) do
    i = lo + 1
    while i <= hi do
        v = a[i]
        j = i - 1
        while j >= lo and a[j] > v do
            a[j + 1] = a[j]
            j = j - 1
        end
        a[j + 1] = v
        i = i + 1
    end
    0
end

// _sort_part(a, lo, hi): partisi Lomuto, pivot = median-of-three; return posisi pivot
_sort_part(a, lo, hi) do
    m = lo + (hi - lo) / 2
    if a[m] < a[lo] do _sort_swap(a, lo, m) end
    if a[hi] < a[lo] do _sort_swap(a, lo, hi) end
    if a[hi] < a[m] do _sort_swap(a, m, hi) end
    pv = a[hi]
    i = lo - 1
    j = lo
    while j < hi do
        if a[j] <= pv do
            i = i + 1
            _sort_swap(a, i, j)
        end
        j = j + 1
    end
    _sort_swap(a, i + 1, hi)
    i + 1
end

// _sort_qsort(a, lo, hi): quicksort sisi-kecil-rekursi (stack O(log n))
_sort_qsort(a, lo, hi) do
    while lo < hi do
        if hi - lo < 12 do
            _sort_insert(a, lo, hi)
            lo = hi
        else do
            p = _sort_part(a, lo, hi)
            if p - lo < hi - p do
                _sort_qsort(a, lo, p - 1)
                lo = p + 1
            else do
                _sort_qsort(a, p + 1, hi)
                hi = p - 1
            end
        end
    end
    0
end

// sort_asc(a): urut naik, in-place; return a
sort_asc(a) do
    _sort_qsort(a, 0, size(a) - 1)
    a
end

// sort_desc(a): urut menurun (asc lalu dibalik), in-place; return a
sort_desc(a) do
    sort_asc(a)
    n = size(a)
    i = 0
    j = n - 1
    while i < j do
        _sort_swap(a, i, j)
        i = i + 1
        j = j - 1
    end
    a
end

// sort_str(a): urut array string (perbandingan isi via str_cmp), in-place
_sort_part_str(a, lo, hi) do
    m = lo + (hi - lo) / 2
    if str_cmp(a[m], a[lo]) < 0 do _sort_swap(a, lo, m) end
    if str_cmp(a[hi], a[lo]) < 0 do _sort_swap(a, lo, hi) end
    if str_cmp(a[hi], a[m]) < 0 do _sort_swap(a, m, hi) end
    pv = a[hi]
    i = lo - 1
    j = lo
    while j < hi do
        if str_cmp(a[j], pv) <= 0 do
            i = i + 1
            _sort_swap(a, i, j)
        end
        j = j + 1
    end
    _sort_swap(a, i + 1, hi)
    i + 1
end

_sort_qsort_str(a, lo, hi) do
    if lo < hi do
        p = _sort_part_str(a, lo, hi)
        _sort_qsort_str(a, lo, p - 1)
        _sort_qsort_str(a, p + 1, hi)
    end
    0
end

sort_str(a) do
    _sort_qsort_str(a, 0, size(a) - 1)
    a
end

// _sort_new_copy(a): salinan array inti (count di slot depan + item)
_sort_new_copy(a) do
    n = size(a)
    out = alloc(8 * (n + 1))
    write_u64(out, 0, n)
    k = 0
    while k < n do
        out[k] = a[k]
        k = k + 1
    end
    out
end

// argsort_asc(a): array INDEKS yang mengurutkan a (array baru, stabil terhadap isi)
_argsort_part(ix, a, lo, hi) do
    m = lo + (hi - lo) / 2
    if a[ix[m]] < a[ix[lo]] do _sort_swap(ix, lo, m) end
    if a[ix[hi]] < a[ix[lo]] do _sort_swap(ix, lo, hi) end
    if a[ix[hi]] < a[ix[m]] do _sort_swap(ix, m, hi) end
    pv = a[ix[hi]]
    i = lo - 1
    j = lo
    while j < hi do
        if a[ix[j]] <= pv do
            i = i + 1
            _sort_swap(ix, i, j)
        end
        j = j + 1
    end
    _sort_swap(ix, i + 1, hi)
    i + 1
end

_argsort_qsort(ix, a, lo, hi) do
    if lo < hi do
        p = _argsort_part(ix, a, lo, hi)
        _argsort_qsort(ix, a, lo, p - 1)
        _argsort_qsort(ix, a, p + 1, hi)
    end
    0
end

argsort_asc(a) do
    n = size(a)
    ix = alloc(8 * (n + 1))
    write_u64(ix, 0, n)
    k = 0
    while k < n do
        ix[k] = k
        k = k + 1
    end
    _argsort_qsort(ix, a, 0, n - 1)
    ix
end

// dedup_sorted(a): buang duplikat dari array TERURUT (array baru)
dedup_sorted(a) do
    n = size(a)
    un = 0
    k = 0
    while k < n do
        if un == 0 do un = 1
        else if a[k] != a[un - 1] do un = un + 1 end
        k = k + 1
    end
    out = alloc(8 * (un + 1))
    write_u64(out, 0, un)
    w = 0
    k = 0
    while k < n do
        if w == 0 do
            out[0] = a[0]
            w = 1
        else if a[k] != out[w - 1] do
            out[w] = a[k]
            w = w + 1
        end
        k = k + 1
    end
    out
end

// is_sorted(a): 1 bila elemen naik (boleh sama)
is_sorted(a) do
    n = size(a)
    ok = 1
    k = 1
    while k < n do
        if a[k - 1] > a[k] do ok = 0 end
        k = k + 1
    end
    ok
end

// binary_search(a, x): indeks x pada array terurut naik, atau 0 - 1
binary_search(a, x) do
    lo = 0
    hi = size(a) - 1
    found = 0 - 1
    while lo <= hi do
        m = lo + (hi - lo) / 2
        if a[m] == x do
            found = m
            lo = hi + 1
        else if a[m] < x do lo = m + 1
        else hi = m - 1 end
    end
    found
end

// binary_search_str(a, s): indeks string pada array terurut, atau 0 - 1
binary_search_str(a, s) do
    lo = 0
    hi = size(a) - 1
    found = 0 - 1
    while lo <= hi do
        m = lo + (hi - lo) / 2
        c = str_cmp(a[m], s)
        if c == 0 do
            found = m
            lo = hi + 1
        else if c < 0 do lo = m + 1
        else hi = m - 1 end
    end
    found
end
