// ===========================================================================
// lib/crypto.pw — Sovereign Pure Cryptography Library for Purwa
// ===========================================================================
// Provides 100% pure, zero-dependency, self-contained implementations of:
// - SHA-256 (FIPS 180-4 standard cryptographic hash)
// - HMAC-SHA256 (RFC 2104 / RFC 4231 message authentication)
// - MD5 (RFC 1321 message digest)
// - Base64 (RFC 4648 encode & decode)
// - Hex (hexadecimal encode & decode)
// - CRC32 (IEEE 802.3 checksum)
// - FNV-1a (32-bit fast non-cryptographic hash)
// - UUID v4 (RFC 4122 random unique identifier generator)
// ===========================================================================

// ---- 32-bit Integer Bitwise Math Helpers ----
_cr_m32(x) = x & 4294967295

_cr_rotr32(x, n) do
    v = x & 4294967295
    s = n % 32
    if s == 0 then v
    else (((v >> s) | (v << (32 - s))) & 4294967295)
end

_cr_rotl32(x, n) do
    v = x & 4294967295
    s = n % 32
    if s == 0 then v
    else (((v << s) | (v >> (32 - s))) & 4294967295)
end

_cr_shr32(x, n) = (x & 4294967295) >> n

// ---- Hex Encoding & Decoding ----
global _CR_HEX_CHARS = "0123456789abcdef"

hex_encode_bytes(buf, len) do
    if len <= 0 then ""
    else do
        out = alloc(len * 2 + 1)
        i = 0
        w = 0
        while i < len do
            b = get_byte(buf, i) & 255
            hi = (b >> 4) & 15
            lo = b & 15
            set_byte(out, w, get_byte(_CR_HEX_CHARS, hi))
            set_byte(out, w + 1, get_byte(_CR_HEX_CHARS, lo))
            w += 2
            i += 1
        end
        set_byte(out, w, 0)
        out
    end
end

hex_encode(s) = hex_encode_bytes(s, str_len(s))

_cr_hex_val(c) =
    if c >= 48 and c <= 57 then c - 48
    else if c >= 97 and c <= 102 then c - 97 + 10
    else if c >= 65 and c <= 70 then c - 65 + 10
    else 0

hex_decode(hex_str) do
    L = str_len(hex_str)
    if L == 0 then ""
    else do
        out_len = L / 2
        out = alloc(out_len + 1)
        i = 0
        w = 0
        while i < L - 1 do
            h1 = _cr_hex_val(get_byte(hex_str, i))
            h2 = _cr_hex_val(get_byte(hex_str, i + 1))
            set_byte(out, w, (h1 << 4) | h2)
            w += 1
            i += 2
        end
        set_byte(out, w, 0)
        out
    end
end

// ---- Base64 (RFC 4648) ----
global _CR_B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

base64_encode_bytes(buf, len) do
    if len <= 0 then ""
    else do
        out_cap = ((len + 2) / 3) * 4 + 1
        out = alloc(out_cap)
        i = 0
        w = 0
        while i < len do
            b0 = get_byte(buf, i) & 255
            b1 = if i + 1 < len then get_byte(buf, i + 1) & 255 else 0
            b2 = if i + 2 < len then get_byte(buf, i + 2) & 255 else 0
            
            trip = (b0 << 16) | (b1 << 8) | b2
            
            set_byte(out, w, get_byte(_CR_B64_CHARS, (trip >> 18) & 63))
            set_byte(out, w + 1, get_byte(_CR_B64_CHARS, (trip >> 12) & 63))
            
            if i + 1 < len do
                set_byte(out, w + 2, get_byte(_CR_B64_CHARS, (trip >> 6) & 63))
            else do
                set_byte(out, w + 2, 61) // '='
            end
            
            if i + 2 < len do
                set_byte(out, w + 3, get_byte(_CR_B64_CHARS, trip & 63))
            else do
                set_byte(out, w + 3, 61) // '='
            end
            
            w += 4
            i += 3
        end
        set_byte(out, w, 0)
        out
    end
end

base64_encode(s) = base64_encode_bytes(s, str_len(s))

_cr_b64_val(c) =
    if c >= 65 and c <= 90 then c - 65
    else if c >= 97 and c <= 122 then c - 97 + 26
    else if c >= 48 and c <= 57 then c - 48 + 52
    else if c == 43 then 62 // '+'
    else if c == 47 then 63 // '/'
    else 0

base64_decode(s) do
    L = str_len(s)
    if L == 0 then ""
    else do
        out_cap = (L / 4) * 3 + 4
        out = alloc(out_cap)
        i = 0
        w = 0
        while i < L do
            c0 = get_byte(s, i)
            c1 = if i + 1 < L then get_byte(s, i + 1) else 61
            c2 = if i + 2 < L then get_byte(s, i + 2) else 61
            c3 = if i + 3 < L then get_byte(s, i + 3) else 61
            
            v0 = _cr_b64_val(c0)
            v1 = _cr_b64_val(c1)
            v2 = if c2 == 61 then 0 else _cr_b64_val(c2)
            v3 = if c3 == 61 then 0 else _cr_b64_val(c3)
            
            trip = (v0 << 18) | (v1 << 12) | (v2 << 6) | v3
            
            set_byte(out, w, (trip >> 16) & 255)
            w += 1
            if c2 != 61 do
                set_byte(out, w, (trip >> 8) & 255)
                w += 1
            end
            if c3 != 61 do
                set_byte(out, w, trip & 255)
                w += 1
            end
            i += 4
        end
        set_byte(out, w, 0)
        out
    end
end

