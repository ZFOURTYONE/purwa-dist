global _CR_SHA256_K = 0

sha256_bytes_raw(data, len, out32) do
    if _CR_SHA256_K == 0 do _CR_SHA256_K = _cr_init_sha256_k() end
    k_table = _CR_SHA256_K
    
    pad_len = len + 9
    rem = pad_len % 64
    total_len = if rem == 0 then pad_len else pad_len + (64 - rem)
    
    buf = alloc(total_len)
    mem_set(buf, 0, total_len)
    
    i = 0
    while i < len do
        set_byte(buf, i, get_byte(data, i))
        i += 1
    end
    
    set_byte(buf, len, 128)
    
    bit_len = len * 8
    set_byte(buf, total_len - 4, (bit_len >> 24) & 255)
    set_byte(buf, total_len - 3, (bit_len >> 16) & 255)
    set_byte(buf, total_len - 2, (bit_len >> 8) & 255)
    set_byte(buf, total_len - 1, bit_len & 255)
    
    h0 = 1779033703
    h1 = 3144134277
    h2 = 1013904242
    h3 = 2773480762
    h4 = 1359893119
    h5 = 2600822924
    h6 = 528734635
    h7 = 1541459225
    
    w = make_array(64, 0)
    
    chunk_off = 0
    while chunk_off < total_len do
        t = 0
        while t < 16 do
            b0 = get_byte(buf, chunk_off + t * 4) & 255
            b1 = get_byte(buf, chunk_off + t * 4 + 1) & 255
            b2 = get_byte(buf, chunk_off + t * 4 + 2) & 255
            b3 = get_byte(buf, chunk_off + t * 4 + 3) & 255
            w[t] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
            t += 1
        end
        
        t = 16
        while t < 64 do
            w15 = w[t - 15]
            s0 = _cr_rotr32(w15, 7) ^ _cr_rotr32(w15, 18) ^ _cr_shr32(w15, 3)
            w2 = w[t - 2]
            s1 = _cr_rotr32(w2, 17) ^ _cr_rotr32(w2, 19) ^ _cr_shr32(w2, 10)
            w[t] = _cr_m32(w[t - 16] + s0 + w[t - 7] + s1)
            t += 1
        end
        
        ah0 = h0
        ah1 = h1
        ah2 = h2
        ah3 = h3
        ah4 = h4
        ah5 = h5
        ah6 = h6
        ah7 = h7
        
        a = h0
        b = h1
        c = h2
        d = h3
        e = h4
        f = h5
        g = h6
        h = h7
        
        i = 0
        while i < 64 do
            S1 = _cr_rotr32(e, 6) ^ _cr_rotr32(e, 11) ^ _cr_rotr32(e, 25)
            ch = (e & f) ^ ((e ^ 4294967295) & g)
            temp1 = _cr_m32(h + S1 + ch + k_table[i] + w[i])
            S0 = _cr_rotr32(a, 2) ^ _cr_rotr32(a, 13) ^ _cr_rotr32(a, 22)
            maj = (a & b) ^ (a & c) ^ (b & c)
            temp2 = _cr_m32(S0 + maj)
            
            h = g
            g = f
            f = e
            e = _cr_m32(d + temp1)
            d = c
            c = b
            b = a
            a = _cr_m32(temp1 + temp2)
            
            i += 1
        end
        
        h0 = _cr_m32(ah0 + a)
        h1 = _cr_m32(ah1 + b)
        h2 = _cr_m32(ah2 + c)
        h3 = _cr_m32(ah3 + d)
        h4 = _cr_m32(ah4 + e)
        h5 = _cr_m32(ah5 + f)
        h6 = _cr_m32(ah6 + g)
        h7 = _cr_m32(ah7 + h)
        
        chunk_off += 64
    end
    
    drop(w)
    drop(buf)
    
    words = [h0, h1, h2, h3, h4, h5, h6, h7]
    j = 0
    while j < 8 do
        val = words[j]
        set_byte(out32, j * 4, (val >> 24) & 255)
        set_byte(out32, j * 4 + 1, (val >> 16) & 255)
        set_byte(out32, j * 4 + 2, (val >> 8) & 255)
        set_byte(out32, j * 4 + 3, val & 255)
        j += 1
    end
    drop(words)
    out32
end

sha256_bytes(buf, len) do
    raw = alloc(32)
    sha256_bytes_raw(buf, len, raw)
    hex = hex_encode_bytes(raw, 32)
    drop(raw)
    hex
end

sha256(s) = sha256_bytes(s, str_len(s))

// ---- HMAC-SHA256 (RFC 2104) ----
hmac_sha256(key, msg) do
    klen = str_len(key)
    mlen = str_len(msg)
    
    k_block = alloc(64)
    mem_set(k_block, 0, 64)
    
    if klen > 64 do
        sha256_bytes_raw(key, klen, k_block)
    else do
        i = 0
        while i < klen do
            set_byte(k_block, i, get_byte(key, i))
            i += 1
        end
    end
    
    ipad_buf = alloc(64 + mlen)
    opad_buf = alloc(64 + 32)
    
    i = 0
    while i < 64 do
        kb = get_byte(k_block, i)
        set_byte(ipad_buf, i, kb ^ 54)  // 0x36 = 54
        set_byte(opad_buf, i, kb ^ 92)  // 0x5c = 92
        i += 1
    end
    
    i = 0
    while i < mlen do
        set_byte(ipad_buf, 64 + i, get_byte(msg, i))
        i += 1
    end
    
    inner_hash = alloc(32)
    sha256_bytes_raw(ipad_buf, 64 + mlen, inner_hash)
    
    i = 0
    while i < 32 do
        set_byte(opad_buf, 64 + i, get_byte(inner_hash, i))
        i += 1
    end
    
    outer_hash = alloc(32)
    sha256_bytes_raw(opad_buf, 64 + 32, outer_hash)
    
    res = hex_encode_bytes(outer_hash, 32)
    
    drop(k_block)
    drop(ipad_buf)
    drop(opad_buf)
    drop(inner_hash)
    drop(outer_hash)
    
    res
end

