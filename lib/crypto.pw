global _CR_MD5_T = 0

md5_bytes_raw(data, len, out16) do
    if _CR_MD5_T == 0 do _CR_MD5_T = _cr_init_md5_t() end
    t_table = _CR_MD5_T
    
    pad_len = len + 9
    rem = pad_len % 64
    total_len = if rem == 0 then pad_len else pad_len + (64 - rem)
    
    buf = alloc(total_len)
    mem_set(buf, 0, total_len)
    
    i = 0
    while i < len do
        set_byte(buf, i, get_byte(data, i))
        i += 1
    end
    
    set_byte(buf, len, 128)
    
    bit_len = len * 8
    set_byte(buf, total_len - 8, bit_len & 255)
    set_byte(buf, total_len - 7, (bit_len >> 8) & 255)
    set_byte(buf, total_len - 6, (bit_len >> 16) & 255)
    set_byte(buf, total_len - 5, (bit_len >> 24) & 255)
    
    a0 = 1732584193  // 0x67452301
    b0 = 4023233417  // 0xefcdab89
    c0 = 2562383102  // 0x98badcfe
    d0 = 271733878   // 0x10325476
    
    x = make_array(16, 0)
    
    chunk_off = 0
    while chunk_off < total_len do
        t = 0
        while t < 16 do
            b_0 = get_byte(buf, chunk_off + t * 4) & 255
            b_1 = get_byte(buf, chunk_off + t * 4 + 1) & 255
            b_2 = get_byte(buf, chunk_off + t * 4 + 2) & 255
            b_3 = get_byte(buf, chunk_off + t * 4 + 3) & 255
            x[t] = b_0 | (b_1 << 8) | (b_2 << 16) | (b_3 << 24)
            t += 1
        end
        
        aa = a0
        bb = b0
        cc = c0
        dd = d0
        
        i = 0
        while i < 64 do
            f = 0
            g = 0
            s = 0
            if i < 16 do
                f = (bb & cc) | ((bb ^ 4294967295) & dd)
                g = i
                s = if (i % 4) == 0 then 7 else if (i % 4) == 1 then 12 else if (i % 4) == 2 then 17 else 22
            else if i < 32 do
                f = (dd & bb) | ((dd ^ 4294967295) & cc)
                g = (5 * i + 1) % 16
                s = if (i % 4) == 0 then 5 else if (i % 4) == 1 then 9 else if (i % 4) == 2 then 14 else 20
            else if i < 48 do
                f = bb ^ cc ^ dd
                g = (3 * i + 5) % 16
                s = if (i % 4) == 0 then 4 else if (i % 4) == 1 then 11 else if (i % 4) == 2 then 16 else 23
            else do
                f = cc ^ (bb | (dd ^ 4294967295))
                g = (7 * i) % 16
                s = if (i % 4) == 0 then 6 else if (i % 4) == 1 then 10 else if (i % 4) == 2 then 15 else 21
            end
            
            temp = _cr_m32(aa + f + t_table[i] + x[g])
            aa = dd
            dd = cc
            cc = bb
            bb = _cr_m32(bb + _cr_rotl32(temp, s))
            
            i += 1
        end
        
        a0 = _cr_m32(a0 + aa)
        b0 = _cr_m32(b0 + bb)
        c0 = _cr_m32(c0 + cc)
        d0 = _cr_m32(d0 + dd)
        
        chunk_off += 64
    end
    
    drop(x)
    drop(buf)
    
    words = [a0, b0, c0, d0]
    j = 0
    while j < 4 do
        val = words[j]
        set_byte(out16, j * 4, val & 255)
        set_byte(out16, j * 4 + 1, (val >> 8) & 255)
        set_byte(out16, j * 4 + 2, (val >> 16) & 255)
        set_byte(out16, j * 4 + 3, (val >> 24) & 255)
        j += 1
    end
    drop(words)
    out16
end

md5_bytes(buf, len) do
    raw = alloc(16)
    md5_bytes_raw(buf, len, raw)
    hex = hex_encode_bytes(raw, 16)
    drop(raw)
    hex
end

md5(s) = md5_bytes(s, str_len(s))

// ---- CRC32 (IEEE 802.3) ----
_cr_init_crc32_table() do
    tbl = make_array(256, 0)
    i = 0
    while i < 256 do
        c = i
        j = 0
        while j < 8 do
            if (c & 1) != 0 do
                c = 3988292384 ^ ((c >> 1) & 2147483647)  // 0xEDB88320
            else do
                c = (c >> 1) & 2147483647
            end
            j += 1
        end
        tbl[i] = c & 4294967295
        i += 1
    end
    tbl
end

global _CR_CRC32_TBL = 0

crc32_bytes(buf, len) do
    if _CR_CRC32_TBL == 0 do _CR_CRC32_TBL = _cr_init_crc32_table() end
    tbl = _CR_CRC32_TBL
    crc = 4294967295
    i = 0
    while i < len do
        b = get_byte(buf, i) & 255
        idx = (crc ^ b) & 255
        crc = tbl[idx] ^ ((crc >> 8) & 16777215)
        i += 1
    end
    (crc ^ 4294967295) & 4294967295
end

crc32(s) = crc32_bytes(s, str_len(s))

// ---- FNV-1a (32-bit) ----
fnv1a_32_bytes(buf, len) do
    h = 2166136261  // 0x811c9dc5
    i = 0
    while i < len do
        b = get_byte(buf, i) & 255
        h = _cr_m32((h ^ b) * 16777619)
        i += 1
    end
    h
end

fnv1a_32(s) = fnv1a_32_bytes(s, str_len(s))
fnv1a(s) = fnv1a_32(s)

// ---- Cryptographic Random & UUID v4 ----
global _CR_RNG_STATE = 123456789

crypto_random_int() do
    cycles = rdtsc()
    _CR_RNG_STATE = _cr_m32(_CR_RNG_STATE * 1664525 + 1013904223 + cycles)
    _CR_RNG_STATE
end

crypto_random_bytes(out_buf, len) do
    i = 0
    while i < len do
        r = crypto_random_int()
        set_byte(out_buf, i, r & 255)
        i += 1
    end
    out_buf
end

crypto_uuid_v4() do
    raw = alloc(16)
    crypto_random_bytes(raw, 16)
    
    // UUID v4: byte 6 = 0100xxxx (version 4), byte 8 = 10xxxxxx (RFC 4122 variant)
    b6 = (get_byte(raw, 6) & 15) | 64
    set_byte(raw, 6, b6)
    b8 = (get_byte(raw, 8) & 63) | 128
    set_byte(raw, 8, b8)
    
    hex = hex_encode_bytes(raw, 16)
    drop(raw)
    
    p1 = slice(hex, 0, 8)
    p2 = slice(hex, 8, 12)
    p3 = slice(hex, 12, 16)
    p4 = slice(hex, 16, 20)
    p5 = slice(hex, 20, 32)
    drop(hex)
    
    uuid = $"{p1}-{p2}-{p3}-{p4}-{p5}"
    drop(p1)
    drop(p2)
    drop(p3)
    drop(p4)
    drop(p5)
    uuid
end
