// lib/format.pw - Pemformatan teks untuk Purwa (v36.7)

format_num(n) = do
    // ribuan dipisah koma: 1234567 -> "1,234,567"; dukung negatif & nol
    if n == 0 do "0"
    else do
        x = if n < 0 do 0 - n else n end;
        res = "";
        pos = 0;
        while x > 0 do
            g = x % 1000;
            x = x / 1000;
            seg = to_text(g);
            if x > 0 and g < 10 do seg = concat("00", seg)
            else if x > 0 and g < 100 do seg = concat("0", seg)
            else 0 end;
            if pos == 0 do res = seg
            else res = concat(seg, concat(",", res)) end;
            pos = pos + 1
        end;
        if n < 0 do concat("-", res) else res end
    end
end;

join(strs, len, sep) do
    res = ""
    i = 0
    while i < len do
        if i == 0 do res = strs[i]
        else res = concat(res, concat(sep, strs[i])) end
        i = i + 1
    end
    res
end
