// lib/elf_loader.pw — Minimal ELF64 .so loader (dlopen/dlsym equivalent)
// Zero external dependencies: pure Purwa + syscall + read_file builtins.
//
// Fase 1 (v37.24): load .so PIC, tanpa relokasi, diverifikasi pada
//                  libffi_test.so (adder/mul3).
// Fase 2 (v37.25): terapkan relokasi R_X86_64_RELATIVE + R_X86_64_GLOB_DAT
//                  (GOT setup), mprotect segmen kode ke RX (W^X), elf_close
//                  melakukan munmap. Diverifikasi pada libprobe51.so
//                  (read_global via GOT, read_ptr via RELATIVE).
//
// Batasan loader minimal saat ini:
//   - Asumsi base vaddr (min PT_LOAD) == 0 (layout `ld -shared`); jika != 0
//     maka elf_load gagal (return 0).
//   - Relokasi lain (R_X86_64_JUMP_SLOT, PC32, dst.) belum ditangani —
//     aplikasinya dilewati (slot dibiarkan berisi addend mentah).
//   - Tidak ada DT_NEEDED, tidak ada TLS/IFUNC.
//
// Usage:
//   import "elf_loader"
//   h = elf_load("libfoo.so")
//   fn = elf_find(h, "adder")
//   r = call_dll(fn, 40, 2)
//   elf_close(h)

global ELF_E_PHOFF = 0x20
global ELF_E_PHENTSIZE = 0x36
global ELF_E_PHNUM = 0x38

global PT_LOAD = 1
global PT_DYNAMIC = 2

global DT_NULL = 0
global DT_STRTAB = 5
global DT_SYMTAB = 6
global DT_RELA = 7
global DT_RELASZ = 8
global DT_RELAENT = 9
global DT_STRSZ = 10
global DT_SYMENT = 11

// p_flags (Elf64_Phdr.flags)
global PF_X = 1
global PF_W = 2
global PF_R = 4

// Relocation types (x86-64 / ELF64)
global R_X86_64_RELATIVE = 8
global R_X86_64_GLOB_DAT = 6

b16(buf, off) = get_byte(buf, off) + get_byte(buf, off + 1) * 256
b32(buf, off) = get_byte(buf, off) + get_byte(buf, off + 1) * 256 + get_byte(buf, off + 2) * 65536 + get_byte(buf, off + 3) * 16777216
b64(buf, off) = b32(buf, off) + b32(buf, off + 4) * 4294967296

st32(p, off, v) do
    u = if v < 0 then v + 4294967296 else v
    set_byte(p, off + 0, u % 256)
    set_byte(p, off + 1, (u / 256) % 256)
    set_byte(p, off + 2, (u / 65536) % 256)
    set_byte(p, off + 3, (u / 16777216) % 256)
end

st64(p, off, v) do
    ll = v % 4294967296
    lo = if ll < 0 then ll + 4294967296 else ll
    st32(p, off, lo)
    rest = (v - lo) / 4294967296
    st32(p, off + 4, rest)
end

// elf_load(path) -> base (handle mmap RW, kemudian proteksi diterapkan) atau 0
// Returns base = map_addr + 4096 (header 4096-byte menyimpan total mmap size).
elf_load(path) do
    buf = alloc(1048576)
    n = read_file(path, buf, 1048576)
    if n < 64 then do
        drop(buf)
        0
    end else do
        if get_byte(buf, 0) != 127 or get_byte(buf, 1) != 69 or
           get_byte(buf, 2) != 76 or get_byte(buf, 3) != 70 then do
            drop(buf)
            0
        end else do
            phoff = b64(buf, ELF_E_PHOFF)
            phent = b16(buf, ELF_E_PHENTSIZE)
            phnum = b16(buf, ELF_E_PHNUM)
            // rentang vaddr: base = min PT_LOAD.vaddr, total = max (vaddr+memsz)
            base = 0 - 1   // -1 = belum di-set
            total = 0
            i = 0
            while i < phnum do
                off = phoff + i * phent
                if b32(buf, off) == PT_LOAD then do
                    va = b64(buf, off + 16)
                    ms = b64(buf, off + 40)
                    if base == 0 - 1 then do
                        base = va
                    end else do
                        if va < base then base = va
                    end
                    e = va + ms
                    if e > total then total = e
                end
                i = i + 1
            end
            // Batasan: base vaddr harus 0 (layout `ld -shared`).
            if base != 0 or total <= base then do
                drop(buf)
                0
            end else do
                ms = total - base
                ms = (ms + 4095) / 4096 * 4096
                // mmap RW (prot=3) + 4096-byte halaman header utk menyimpan size.
                // Fase 1 memakai RWX (prot=7); Fase 2 W^X: tulis/relokasi lalu
                // mprotect segmen ke prot yang tepat.
                map_addr = syscall(9, 0, ms + 4096, 3, 34, 0 - 1, 0)
                if map_addr < 0 then do
                    drop(buf)
                    0
                end else do
                    hdl = map_addr + 4096
                    st64(map_addr, 0, ms + 4096)   // simpan total mmap size
                    // Copy PT_LOAD segments (file offset -> hdl + vaddr)
                    j = 0
                    while j < phnum do
                        off = phoff + j * phent
                        if b32(buf, off) == PT_LOAD then do
                            foff = b64(buf, off + 8)
                            va = b64(buf, off + 16)
                            fsz = b64(buf, off + 32)
                            msz = b64(buf, off + 40)
                            k = 0
                            while k < fsz do
                                set_byte(hdl + va + k, 0, get_byte(buf, foff + k))
                                k = k + 1
                            end
                            k = 0
                            while k < msz - fsz do
                                set_byte(hdl + va + fsz + k, 0, 0)
                                k = k + 1
                            end
                        end
                        j = j + 1
                    end
                    drop(buf)
                    // Terapkan relokasi (RELATIVE + GLOB_DAT) SELAGI RW,
                    // lalu proteksi segmen (W^X).
                    if elf_reloc(hdl) == 0 then do
                        // relokasi gagal (mis. tiada PT_DYNAMIC) — lepas.
                        sz0 = b64(hdl - 4096, 0)
                        syscall(11, hdl - 4096, sz0, 0, 0, 0, 0)
                        0
                    end else do
                        elf_protect(hdl, phoff, phent, phnum)
                        hdl
                    end
                end
            end
        end
    end
end

// elf_reloc(handle) -> 1 sukses (atau tanpa relokasi), 0 gagal.
// Terapkan DT_RELA: R_X86_64_RELATIVE (B+A) dan R_X86_64_GLOB_DAT (S).
elf_reloc(handle) do
    phoff = b64(handle, ELF_E_PHOFF)
    phent = b16(handle, ELF_E_PHENTSIZE)
    phnum = b16(handle, ELF_E_PHNUM)
    dyn_v = 0
    dyn_sz = 0
    i = 0
    while i < phnum and dyn_v == 0 do
        off = phoff + i * phent
        if b32(handle, off) == PT_DYNAMIC then do
            dyn_v = b64(handle, off + 16)
            dyn_sz = b64(handle, off + 40)
        end
        i = i + 1
    end
    if dyn_v == 0 then 0
    else do
        rela = 0
        relasz = 0
        relaent = 0
        symtab = 0
        pos = 0
        while pos < dyn_sz do
            tag = b64(handle, dyn_v + pos)
            val = b64(handle, dyn_v + pos + 8)
            if tag == DT_NULL then pos = dyn_sz
            else do
                if tag == DT_SYMTAB then symtab = val
                else if tag == DT_RELA then rela = val
                else if tag == DT_RELASZ then relasz = val
                else if tag == DT_RELAENT then relaent = val
                pos = pos + 16
            end
        end
        if rela == 0 or relasz == 0 then do
            1    // tidak ada relokasi — dianggap sukses
        end else do
            if relaent == 0 then relaent = 24
            cnt = relasz / relaent
            r = 0
            while r < cnt do
                ro = rela + r * relaent
                r_off = b64(handle, ro)
                r_info = b64(handle, ro + 8)
                r_add = b64(handle, ro + 16)
                rtyp = r_info % 4294967296        // tipe = info & 0xffffffff
                symidx = (r_info - rtyp) / 4294967296   // simbol = info >> 32
                if rtyp == R_X86_64_RELATIVE then do
                    st64(handle + r_off, 0, handle + r_add)
                end else if rtyp == R_X86_64_GLOB_DAT then do
                    if symtab != 0 and symidx > 0 then do
                        sv = b64(handle, symtab + symidx * 24 + 8)
                        st64(handle + r_off, 0, handle + sv)
                    end
                end
                r = r + 1
            end
            1
        end
    end
end

// elf_protect(handle, phoff, phent, phnum) — W^X: mprotect per-halaman ke
// gabungan (union) flag PT_LOAD yang overlap. Segmen kode -> RX, data -> RW.
elf_protect(handle, phoff, phent, phnum) do
    total = 0
    i = 0
    while i < phnum do
        off = phoff + i * phent
        if b32(handle, off) == PT_LOAD then do
            va = b64(handle, off + 16)
            msz = b64(handle, off + 40)
            e = va + msz
            if e > total then total = e
        end
        i = i + 1
    end
    p0 = handle
    p1 = (handle + total + 4095) / 4096 * 4096
    pa = p0
    while pa < p1 do
        prot = elf_page_prot(handle, pa, phoff, phent, phnum)
        if prot == 0 then prot = 1
        q = pa + 4096
        done = 0
        while q < p1 and done == 0 do
            qp = elf_page_prot(handle, q, phoff, phent, phnum)
            if qp == 0 then qp = 1
            if qp == prot then q = q + 4096 else done = 1
        end
        syscall(10, pa, q - pa, prot, 0, 0, 0)   // mprotect
        pa = q
    end
end

// elf_page_prot(handle, page, phoff, phent, phnum) -> prot untuk halaman `page`.
elf_page_prot(handle, page, phoff, phent, phnum) do
    prot = 0
    i = 0
    while i < phnum do
        off = phoff + i * phent
        if b32(handle, off) == PT_LOAD then do
            va = b64(handle, off + 16)
            msz = b64(handle, off + 40)
            flags = b32(handle, off + 4)
            seg_b = handle + va
            seg_e = seg_b + msz
            if seg_e > page and seg_b < page + 4096 then do
                sp = 0
                if (flags & PF_R) != 0 then sp = sp | 1     // PROT_READ
                if (flags & PF_W) != 0 then sp = sp | 2     // PROT_WRITE
                if (flags & PF_X) != 0 then sp = sp | 4     // PROT_EXEC
                prot = prot | sp
            end
        end
        i = i + 1
    end
    prot
end

// elf_find(handle, name) -> alamat fungsi/data atau 0
elf_find(handle, name) do
    phoff = b64(handle, ELF_E_PHOFF)
    phent = b16(handle, ELF_E_PHENTSIZE)
    phnum = b16(handle, ELF_E_PHNUM)
    dyn_v = 0
    dyn_sz = 0
    i = 0
    while i < phnum and dyn_v == 0 do
        off = phoff + i * phent
        if b32(handle, off) == PT_DYNAMIC then do
            dyn_v = b64(handle, off + 16)
            dyn_sz = b64(handle, off + 40)
        end
        i = i + 1
    end
    if dyn_v == 0 then 0
    else do
        symtab = 0
        strtab = 0
        strsz = 0
        syment = 24
        pos = 0
        while pos < dyn_sz do
            tag = b64(handle, dyn_v + pos)
            val = b64(handle, dyn_v + pos + 8)
            if tag == DT_NULL then pos = dyn_sz
            else do
                if tag == DT_SYMTAB then symtab = val
                else if tag == DT_STRTAB then strtab = val
                else if tag == DT_STRSZ then strsz = val
                else if tag == DT_SYMENT then syment = val
                pos = pos + 16
            end
        end
        if symtab == 0 or strtab == 0 then 0
        else do
            idx = 0
            found = 0
            while idx < 200 and found == 0 do
                so = symtab + idx * syment
                nm = b32(handle, so)
                if nm > 0 and nm < strsz then do
                    j = 0
                    mok = 1
                    while j < 200 do
                        cb = get_byte(handle, strtab + nm + j)
                        nb = get_byte(name, j)
                        if cb != nb then do
                            mok = 0
                            j = 200
                        end else if cb == 0 then
                            j = 200
                        else
                            j = j + 1
                    end
                    if mok == 1 then do
                        sv = b64(handle, so + 8)
                        if sv != 0 then found = handle + sv
                        idx = 200
                    end
                end
                idx = idx + 1
            end
            found
        end
    end
end

// elf_close(handle) — munmap seluruh mapping (halaman header + image).
elf_close(handle) do
    if handle == 0 then 0
    else do
        sz = b64(handle - 4096, 0)
        if sz > 0 then syscall(11, handle - 4096, sz, 0, 0, 0, 0)
        0
    end
end
