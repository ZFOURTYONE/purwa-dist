// lib/json.pw — JSON reader/writer (human-centric, flat objects)
// Python `json` module style: json_get_str(s, "key"), json_get_num(s, "key"),
// json_build_str("name", "Purwa"), json_object([...]), json_array([...]).
// Pure Purwa, zero dependencies. Handles flat objects and arrays.
//
// Quick start:
//   s = json_object([json_field_str("name", "Purwa"), json_field_num("year", 2026)])
//   n = json_get_num(s, "year")        // 2026
//   name = json_get_str(s, "name")     // "Purwa"
//
// Limitation: nested objects/arrays are not parsed (v1); use explicit
// extraction for known keys.

// ---- build helpers ----

// json_escape(s): escape a string for JSON (quote, backslash, control chars)
json_escape(s) do
    L = str_len(s)
    // count escapes needed
    extra = 0
    i = 0
    while i < L do
        c = get_byte(s, i)
        if c == 34 or c == 92 or c == 10 or c == 13 or c == 9 then extra = extra + 1
        else if c < 32 then extra = extra + 5  // \uXXXX
        i = i + 1
    end
    out = alloc(L + extra + 3)  // leading/trailing quote + NUL
    w = 0
    set_byte(out, w, 34); w = w + 1  // '"'
    i = 0
    while i < L do
        c = get_byte(s, i)
        if c == 34 then do set_byte(out, w, 92); set_byte(out, w+1, 34); w = w + 2
        end else if c == 92 then do set_byte(out, w, 92); set_byte(out, w+1, 92); w = w + 2
        end else if c == 10 then do set_byte(out, w, 92); set_byte(out, w+1, 110); w = w + 2
        end else if c == 13 then do set_byte(out, w, 92); set_byte(out, w+1, 114); w = w + 2
        end else if c == 9 then do set_byte(out, w, 92); set_byte(out, w+1, 116); w = w + 2
        end else do
            set_byte(out, w, c); w = w + 1
        end
        i = i + 1
    end
    set_byte(out, w, 34); w = w + 1  // '"'
    set_byte(out, w, 0)
    out
end

// json_field_str(key, value): -> "key":"value" (value is auto-escaped)
json_field_str(key, value) do
    concat(concat(concat("\"", key), "\":"), json_escape(value))
end

// json_field_num(key, value): -> "key":123 (value written as-is)
json_field_num(key, value) do
    concat(concat(concat("\"", key), "\":"), to_text(value))
end

// json_field_bool(key, value): -> "key":true/false
json_field_bool(key, value) do
    concat(concat(concat("\"", key), "\":"), if value then "true" else "false")
end

// json_object(fields): -> { "k1":"v1", "k2":123, ... }
// fields = array of pre-formatted "key":value strings
json_object(fields) do
    n = size(fields)
    s = "{"
    i = 0
    while i < n do
        if i > 0 then s = s + ","
        s = s + fields[i]
        i = i + 1
    end
    s + "}"
end

// json_array(items): -> [ item1, item2, ... ]
// items = array of pre-formatted value strings
json_array(items) do
    n = size(items)
    s = "["
    i = 0
    while i < n do
        if i > 0 then s = s + ","
        s = s + items[i]
        i = i + 1
    end
    s + "]"
end

// ---- parse helpers ----

// json_find_key(text, key): find "key": in text, return index after ':'
// Returns -1 if not found.
json_find_key(text, key) do
    L = str_len(text)
    kL = str_len(key)
    i = 0
    found = 0 - 1
    while i + kL + 2 <= L and found < 0 do
        if get_byte(text, i) == 34 then do
            // compare: "key":
            s = i + 1
            is_eq = true
            j = 0
            while j < kL and is_eq do
                if get_byte(text, s + j) != get_byte(key, j) then is_eq = false
                j = j + 1
            end
            if is_eq and get_byte(text, s + kL) == 34 then do
                // skip "key"
                ci = s + kL + 1
                while ci < L and get_byte(text, ci) != 58 do ci = ci + 1 end  // ':'
                if ci < L then found = ci + 1
            end
            i = i + 1
        end else i = i + 1
    end
    found
end

// json_skip_ws(text, i): skip whitespace from index i
json_skip_ws(text, i) do
    while i < str_len(text) and (get_byte(text, i) == 32 or get_byte(text, i) == 9
           or get_byte(text, i) == 10 or get_byte(text, i) == 13) do i = i + 1 end
    i
end

// json_read_str(text, start): read a JSON string value starting at start
// Returns the parsed string (without quotes, unescaped) or empty string.
// Mendukung escape \n \r \t \" \\ DAN \uXXXX (decode ke UTF-8).
json_read_str(text, start) do
    i = json_skip_ws(text, start)
    if i >= str_len(text) or get_byte(text, i) != 34 then ""
    else do
        i = i + 1  // skip opening quote
        // pass 1: count output length (estimasi; \uXXXX bisa >1 byte,
        // alokasi cukup besar lalu di-trim)
        n = 0
        j = i
        while j < str_len(text) and get_byte(text, j) != 34 do
            if get_byte(text, j) == 92 and j + 1 < str_len(text) then do
                j = j + 1
                if get_byte(text, j) == 117 then j = j + 4  // \uXXXX
            end
            n = n + 1
            j = j + 1
        end
        out = alloc(n * 3 + 1)
        w = 0
        while i < str_len(text) and get_byte(text, i) != 34 do
            c = get_byte(text, i)
            if c == 92 and i + 1 < str_len(text) then do
                i = i + 1
                c2 = get_byte(text, i)
                if c2 == 110 then do set_byte(out, w, 10); w = w + 1
                end else if c2 == 114 then do set_byte(out, w, 13); w = w + 1
                end else if c2 == 116 then do set_byte(out, w, 9); w = w + 1
                end else if c2 == 34 then do set_byte(out, w, 34); w = w + 1
                end else if c2 == 92 then do set_byte(out, w, 92); w = w + 1
                end else if c2 == 117 then do
                    // \uXXXX — decode 4 hex digits ke UTF-8
                    if i + 4 < str_len(text) then do
                        h1 = jh_hex(get_byte(text, i + 1))
                        h2 = jh_hex(get_byte(text, i + 2))
                        h3 = jh_hex(get_byte(text, i + 3))
                        h4 = jh_hex(get_byte(text, i + 4))
                        if h1 >= 0 and h2 >= 0 and h3 >= 0 and h4 >= 0 then do
                            cp = (h1 << 12) | (h2 << 8) | (h3 << 4) | h4
                            w = jh_utf8(out, w, cp)
                            i = i + 4
                        end else do
                            set_byte(out, w, 92)
                            w = w + 1
                        end
                    end else do
                        set_byte(out, w, 92)
                        w = w + 1
                    end
                end else do
                    set_byte(out, w, c2)
                    w = w + 1
                end
            end else do
                set_byte(out, w, c)
                w = w + 1
            end
            i = i + 1
        end
        set_byte(out, w, 0)
        // trim ke ukuran sebenarnya
        res = slice(out, 0, w)
        drop(out)
        res
    end
end

// jh_hex(c): nilai hex digit ('0'-'9','a'-'f','A'-'F'); -1 jika bukan hex.
jh_hex(c) do
    if c >= 48 and c <= 57 then c - 48
    else if c >= 97 and c <= 102 then c - 87
    else if c >= 65 and c <= 70 then c - 55
    else 0 - 1
end

// jh_utf8(out, w, cp): tulis codepoint cp (≤0xFFFF) sebagai UTF-8, return w baru.
jh_utf8(out, w, cp) do
    if cp < 128 then do
        set_byte(out, w, cp)
        w + 1
    end else if cp < 2048 then do
        set_byte(out, w, 192 + (cp >> 6))
        set_byte(out, w + 1, 128 + (cp & 63))
        w + 2
    end else do
        set_byte(out, w, 224 + (cp >> 12))
        set_byte(out, w + 1, 128 + ((cp >> 6) & 63))
        set_byte(out, w + 2, 128 + (cp & 63))
        w + 3
    end
end

// json_read_num(text, start): read a JSON number from start (as i64)
// Returns 0 if not a number (or 0).
json_read_num(text, start) do
    i = json_skip_ws(text, start)
    if i >= str_len(text) then 0
    else do
        neg = false
        if get_byte(text, i) == 45 then do neg = true; i = i + 1 end
        v = 0
        while i < str_len(text) and get_byte(text, i) >= 48 and get_byte(text, i) <= 57 do
            v = v * 10 + (get_byte(text, i) - 48)
            i = i + 1
        end
        if neg then 0 - v else v
    end
end

// ---- public parse API ----

// json_get_str(text, key): extract string value for key from JSON object
json_get_str(text, key) do
    pos = json_find_key(text, key)
    if pos < 0 then ""
    else json_read_str(text, pos)
end

// json_get_num(text, key): extract integer value for key from JSON object
json_get_num(text, key) do
    pos = json_find_key(text, key)
    if pos < 0 then 0
    else json_read_num(text, pos)
end

// json_has(text, key): 1 if key exists in JSON object
json_has(text, key) do
    if json_find_key(text, key) >= 0 then true else false
end