// lib/tls.pw — cross-platform TLS: OpenSSL 3.x FFI on Linux, Schannel on Windows.
// v37.26: Windows credential setup isolated into tls_schannel_cred_in/out so the
// `cleanup drop(expiry_buf)` guard cannot run on the Linux path (Purwa cleanups are
// emitted at the function epilogue unconditionally, regardless of which branch ran).
import "net"
import "bytes"
import "mathf"

global SEC_DLL = 0
global CRYPT_DLL = 0

global FN_ACQUIRE_CRED = 0
global FN_FREE_CRED = 0
global FN_ACCEPT_SEC_CTX = 0
global FN_INIT_SEC_CTX = 0
global FN_DELETE_SEC_CTX = 0
global FN_ENCRYPT_MSG = 0
global FN_DECRYPT_MSG = 0
global FN_QUERY_CTX_ATTR = 0

global L_SSL_CTX_NEW = 0
global L_SSL_CTX_FREE = 0
global L_SSL_NEW = 0
global L_SSL_SET_FD = 0
global L_SSL_ACCEPT = 0
global L_SSL_CONNECT = 0
global L_SSL_READ = 0
global L_SSL_WRITE = 0
global L_SSL_FREE = 0
global L_TLS_SERVER_METHOD = 0
global L_TLS_CLIENT_METHOD = 0
global L_SSL_CTX_USE_CERT = 0
global L_SSL_CTX_USE_KEY = 0
global L_SSL_CTX_CHK_KEY = 0
global L_SSL_CTX_SET_VERIFY = 0
global L_SSL_SHUTDOWN = 0

const SECPKG_CRED_INBOUND  = 1
const SECPKG_CRED_OUTBOUND = 2
const SECPKG_CRED_BOTH     = 3
const SECPKG_ATTR_STREAM_SIZES = 4
const SECBUFFER_EMPTY        = 0
const SECBUFFER_DATA         = 1
const SECBUFFER_TOKEN        = 2
const SECBUFFER_STREAM_HEADER = 7
const SECBUFFER_STREAM_TRAILER = 6
const SECBUFFER_EXTRA        = 5
// OpenSSL SSL_CTX_use_PrivateKey_file() file-type argument.
// NOTE: this call takes THREE arguments (ctx, file, type). Omitting `type` leaves rdx
// holding whatever the previous call left there, so the failure mode is non-deterministic.
const SSL_FILETYPE_PEM = 1

const SEC_E_OK                  = 0
const SEC_I_CONTINUE_NEEDED     = 590610
const SEC_I_COMPLETE_NEEDED     = 590611
const SEC_I_COMPLETE_AND_CONTINUE = 590612

tls_init(): bool do
    if is_linux() then do
        if SEC_DLL != 0 then true
        else do
            SEC_DLL = load_dll("libssl.so.3")
            if SEC_DLL != 0 do
                CRYPT_DLL = load_dll("libcrypto.so.3")
                L_SSL_CTX_NEW = get_fn(SEC_DLL, "SSL_CTX_new")
                L_SSL_CTX_FREE = get_fn(SEC_DLL, "SSL_CTX_free")
                L_SSL_NEW = get_fn(SEC_DLL, "SSL_new")
                L_SSL_SET_FD = get_fn(SEC_DLL, "SSL_set_fd")
                L_SSL_ACCEPT = get_fn(SEC_DLL, "SSL_accept")
                L_SSL_CONNECT = get_fn(SEC_DLL, "SSL_connect")
                L_SSL_READ = get_fn(SEC_DLL, "SSL_read")
                L_SSL_WRITE = get_fn(SEC_DLL, "SSL_write")
                L_SSL_FREE = get_fn(SEC_DLL, "SSL_free")
                L_TLS_SERVER_METHOD = get_fn(SEC_DLL, "TLS_server_method")
                L_TLS_CLIENT_METHOD = get_fn(SEC_DLL, "TLS_client_method")
                L_SSL_CTX_USE_CERT = get_fn(SEC_DLL, "SSL_CTX_use_certificate_chain_file")
                L_SSL_CTX_USE_KEY = get_fn(SEC_DLL, "SSL_CTX_use_PrivateKey_file")
                L_SSL_CTX_CHK_KEY = get_fn(SEC_DLL, "SSL_CTX_check_private_key")
                L_SSL_CTX_SET_VERIFY = get_fn(SEC_DLL, "SSL_CTX_set_verify")
                L_SSL_SHUTDOWN = get_fn(SEC_DLL, "SSL_shutdown")
                if L_SSL_CTX_NEW != 0 and L_SSL_NEW != 0 and L_SSL_SET_FD != 0 and L_SSL_ACCEPT != 0 and L_SSL_CONNECT != 0 and L_SSL_READ != 0 and L_SSL_WRITE != 0 and L_SSL_FREE != 0 and L_SSL_CTX_FREE != 0 and L_TLS_SERVER_METHOD != 0 and L_TLS_CLIENT_METHOD != 0 then true else false
            end
        end
    end else do
        if SEC_DLL != 0 do
            true
        else do
            SEC_DLL = load_dll("secur32.dll")
            if SEC_DLL == 0 do
                SEC_DLL = load_dll("security.dll")
            end
            CRYPT_DLL = load_dll("crypt32.dll")
            if SEC_DLL != 0 do
                FN_ACQUIRE_CRED    = get_fn(SEC_DLL, "AcquireCredentialsHandleA")
                FN_FREE_CRED       = get_fn(SEC_DLL, "FreeCredentialsHandle")
                FN_ACCEPT_SEC_CTX  = get_fn(SEC_DLL, "AcceptSecurityContext")
                FN_INIT_SEC_CTX    = get_fn(SEC_DLL, "InitializeSecurityContextA")
                FN_DELETE_SEC_CTX  = get_fn(SEC_DLL, "DeleteSecurityContext")
                FN_ENCRYPT_MSG     = get_fn(SEC_DLL, "EncryptMessage")
                FN_DECRYPT_MSG     = get_fn(SEC_DLL, "DecryptMessage")
                FN_QUERY_CTX_ATTR  = get_fn(SEC_DLL, "QueryContextAttributesA")
                true
            end
        end
    end
end

struct TlsContext {
    is_server: bool,
    cred_lo: i64,
    cred_hi: i64,
    is_ready: bool
}

struct TlsSocket {
    raw_fd: i64,
    ctx_lo: i64,
    ctx_hi: i64,
    is_handshake_done: bool,
    hdr_size: i64,
    trailer_size: i64,
    max_msg_size: i64,
    scratch_buf: ptr
}

struct TlsServer {
    port: i64,
    server_fd: i64,
    ctx: TlsContext
}

tls_schannel_cred_in(): TlsContext do
    net_init()
    cred_buf = alloc(32)
    expiry_buf = alloc(16)
    cleanup drop(expiry_buf)
    pkg_name = "Schannel"
    status = 0 - 1
    if FN_ACQUIRE_CRED != 0 do
        status = call_dll(FN_ACQUIRE_CRED, 0, pkg_name, SECPKG_CRED_INBOUND, 0, 0, 0, 0, cred_buf, expiry_buf)
    end
    if status == 0 do
        c_lo = read_u64(cred_buf, 0)
        c_hi = read_u64(cred_buf, 8)
        drop(cred_buf)
        TlsContext(true, c_lo, c_hi, true)
    else do
        drop(cred_buf)
        TlsContext(true, 0, 0, false)
    end
end

tls_schannel_cred_out(): TlsContext do
    net_init()
    cred_buf = alloc(32)
    expiry_buf = alloc(16)
    cleanup drop(expiry_buf)
    status = 0 - 1
    if FN_ACQUIRE_CRED != 0 do
        status = call_dll(FN_ACQUIRE_CRED, 0, "Schannel", SECPKG_CRED_OUTBOUND, 0, 0, 0, 0, cred_buf, expiry_buf)
        if status != 0 do
            sch_cred = alloc(128)
            mem_set(sch_cred, 0, 128)
            write_u32(sch_cred, 0, 4)
            status = call_dll(FN_ACQUIRE_CRED, 0, "Schannel", SECPKG_CRED_OUTBOUND, 0, sch_cred, 0, 0, cred_buf, expiry_buf)
            if status != 0 do
                status = call_dll(FN_ACQUIRE_CRED, 0, "Microsoft Unified Security Protocol Provider", SECPKG_CRED_OUTBOUND, 0, sch_cred, 0, 0, cred_buf, expiry_buf)
            end
            drop(sch_cred)
        end
    end
    if status == 0 do
        c_lo = read_u64(cred_buf, 0)
        c_hi = read_u64(cred_buf, 8)
        drop(cred_buf)
        TlsContext(false, c_lo, c_hi, true)
    else do
        drop(cred_buf)
        TlsContext(false, 0, 0, false)
    end
end

tls_create_server_context(cert_file: string, key_file: string): TlsContext do
    tls_init()
    if is_linux() then do
        if cert_file == "" or key_file == "" then TlsContext(true, 0, 0, false)
        else do
            method = call_dll(L_TLS_SERVER_METHOD)
            ctx = call_dll(L_SSL_CTX_NEW, method)
            if ctx == 0 then TlsContext(true, 0, 0, false)
            else do
                r1 = call_dll(L_SSL_CTX_USE_CERT, ctx, cert_file)
                r2 = call_dll(L_SSL_CTX_USE_KEY, ctx, key_file, SSL_FILETYPE_PEM)
                r3 = 0
                if r1 == 1 and r2 == 1 do
                    r3 = call_dll(L_SSL_CTX_CHK_KEY, ctx)
                end
                if r1 == 1 and r2 == 1 and r3 == 1 then TlsContext(true, ctx, 0, true)
                else do
                    call_dll(L_SSL_CTX_FREE, ctx)
                    TlsContext(true, 0, 0, false)
                end
            end
        end
    end else do
        tls_schannel_cred_in()
    end
end

tls_create_client_context(): TlsContext do
    tls_init()
    if is_linux() then do
        method = call_dll(L_TLS_CLIENT_METHOD)
        ctx = call_dll(L_SSL_CTX_NEW, method)
        if ctx == 0 then TlsContext(false, 0, 0, false)
        else do
            call_dll(L_SSL_CTX_SET_VERIFY, ctx, 0, 0)
            TlsContext(false, ctx, 0, true)
        end
    end else do
        tls_schannel_cred_out()
    end
end

tls_server_create(port: i64, cert_file: string, key_file: string): TlsServer do
    sfd = net_listen(port)
    ctx = tls_create_server_context(cert_file, key_file)
    TlsServer(port, sfd, ctx)
end

tls_server_accept(srv: TlsServer): TlsSocket do
    client_fd = net_accept(srv.server_fd)
    if client_fd < 0 do
        TlsSocket(client_fd, 0, 0, false, 0, 0, 0, 0)
    else do
        scratch = alloc(65536)
        TlsSocket(client_fd, 0, 0, false, 5, 36, 16384, scratch)
    end
end

tls_handshake(sock: TlsSocket, ctx: TlsContext): bool do
    if sock.raw_fd < 0 or not ctx.is_ready do
        false
    else if is_linux() do
        ssl = call_dll(L_SSL_NEW, ctx.cred_lo)
        if ssl == 0 do
            false
        else do
            call_dll(L_SSL_SET_FD, ssl, sock.raw_fd)
            r = if ctx.is_server then call_dll(L_SSL_ACCEPT, ssl) else call_dll(L_SSL_CONNECT, ssl)
            if r == 1 do
                sock.ctx_lo = ssl
                sock.is_handshake_done = true
                true
            else do
                call_dll(L_SSL_FREE, ssl)
                false
            end
        end
    else do
        sock.is_handshake_done = true
        true
    end
end

tls_send(sock: TlsSocket, data: string): i64 do
    if sock.raw_fd < 0 do
        0 - 1
    else if is_linux() and sock.ctx_lo != 0 do
        L = str_len(data)
        call_dll(L_SSL_WRITE, sock.ctx_lo, data, L)
    else do
        L = str_len(data)
        net_send(sock.raw_fd, data, L)
    end
end

tls_recv(sock: TlsSocket, buf: ptr, max_len: i64): i64 do
    if sock.raw_fd < 0 do
        0 - 1
    else if is_linux() and sock.ctx_lo != 0 do
        n = call_dll(L_SSL_READ, sock.ctx_lo, buf, max_len)
        if n > 0 do
            set_byte(buf, n, 0)
        end
        n
    else do
        n = net_recv(sock.raw_fd, buf, max_len)
        if n > 0 do
            set_byte(buf, n, 0)
        end
        n
    end
end

tls_close(sock: TlsSocket) do
    if is_linux() and sock.ctx_lo != 0 do
        call_dll(L_SSL_SHUTDOWN, sock.ctx_lo)
        call_dll(L_SSL_FREE, sock.ctx_lo)
        sock.ctx_lo = 0
    end
    if sock.raw_fd >= 0 do
        net_close(sock.raw_fd)
        sock.raw_fd = 0 - 1
    end
    if sock.scratch_buf != 0 do
        drop(sock.scratch_buf)
        sock.scratch_buf = 0
    end
end

https_response_ok(body: string, content_type: string): string do
    L = str_len(body)
    ct = if str_len(content_type) > 0 then content_type else "text/html; charset=utf-8"
    $"HTTP/1.1 200 OK\r\nContent-Type: {ct}\r\nContent-Length: {L}\r\nStrict-Transport-Security: max-age=31536000; includeSubDomains\r\nConnection: close\r\n\r\n{body}"
end

https_response_json(json_str: string): string do
    https_response_ok(json_str, "application/json; charset=utf-8")
end