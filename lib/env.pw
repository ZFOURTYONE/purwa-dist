// lib/env.pw — baca/tulis environment variable (Windows & Linux)
//   get_env(name, buf, max)  -> panjang value (0 = tidak ada, -1 = error)
//   get_env_str(name)        -> string baru ("" jika tidak ada)
//   env_set(name, value)     -> set env var (override in-process)
//   env_init()               -> idempotent, inisialisasi (FFI di Windows)
// Windows: kernel32 via FFI dinamis (pola sama dengan lib/net.pw).
// Linux  : baca /proc/self/environ via syscall murni; env_set mengisi
//          tabel override in-process (execve TIDAK mewarisi override ini —
//          batasan jujur, tanpa libc setenv).

global g_env_k32 = 0
global g_env_gv = 0
global g_env_sv = 0

// --- cabang Linux ---
global g_env_proc = 0        // blob /proc/self/environ (NUL-separated)
global g_env_proc_len = 0
global g_env_ov = 0          // buffer override "NAME=VALUE\0" beruntun
global g_env_ov_len = 0
global g_env_ov_max = 16384

// Cocokkan `name` + '=' pada offset `start` dalam blob `src`.
env_prefix_is(src, start, name, nlen) do
    ok = true
    i = 0
    while ok and i < nlen do
        if get_byte(src, start + i) != get_byte(name, i) then ok = false
        i = i + 1
    end
    if ok then get_byte(src, start + nlen) == 61 else false   // 61 = '='
end

// Salin value (sampai NUL) dari offset vstart ke buf, NUL-terminate.
env_copy_value(src, vstart, buf, max) do
    out = 0
    c = get_byte(src, vstart)
    while c != 0 and out < max - 1 do
        set_byte(buf, out, c)
        out = out + 1
        vstart = vstart + 1
        c = get_byte(src, vstart)
    end
    set_byte(buf, out, 0)
    out
end

env_linux_load() do
    if g_env_proc == 0 then do
        buf = alloc(65536)
        fd = syscall(2, "/proc/self/environ", 0)      // open O_RDONLY
        if fd >= 0 then do
            n = syscall(0, fd, buf, 65535)            // read
            syscall(3, fd)                            // close
            if n > 0 then do
                g_env_proc = buf
                g_env_proc_len = n
            end
        end
    end
    0
end

// Cari name (panjang nl): override table dulu (terakhir menang), lalu /proc.
env_linux_find(name, nl, buf, max) do
    pos = 0
    last = 0 - 1
    while pos < g_env_ov_len do
        elen = 0
        while get_byte(g_env_ov, pos + elen) != 0 do elen = elen + 1 end
        if env_prefix_is(g_env_ov, pos, name, nl) then last = pos
        pos = pos + elen + 1
    end
    if last >= 0 then env_copy_value(g_env_ov, last + nl + 1, buf, max)
    else do
        env_linux_load()
        if g_env_proc == 0 then 0 - 1
        else do
            found = false
            pos = 0
            while pos < g_env_proc_len and not found do
                if env_prefix_is(g_env_proc, pos, name, nl) then found = true
                else do
                    while get_byte(g_env_proc, pos) != 0 do pos = pos + 1 end
                    pos = pos + 1
                end
            end
            if found then env_copy_value(g_env_proc, pos + nl + 1, buf, max) else 0
        end
    end
end

get_env(name, buf, max) do
    if is_linux() then do
        nl = 0
        while get_byte(name, nl) != 0 do nl = nl + 1 end
        env_linux_find(name, nl, buf, max)
    end else do
        env_init()
        if g_env_gv == 0 then 0 - 1
        else do
            n = call_dll(g_env_gv, name, buf, max)
            if n > 0 and n < max then set_byte(buf, n, 0)
            n
        end
    end
end

// Konvenien: salin env ke string baru ("" jika tidak ada).
// Caller bertanggung jawab drop() hasilnya.
get_env_str(name) do
    buf = alloc(4096)
    n = get_env(name, buf, 4096)
    if n > 0 and n < 4096 then do
        slice(buf, 0, n)
    end else ""
end

// Set env var. Return true sukses, false gagal.
// Windows: SetEnvironmentVariableA (mewarisi ke child process).
// Linux  : override in-process — cukup untuk .env loader, BUKAN setenv(3).
env_set(name, value) do
    if is_linux() then do
        if g_env_ov == 0 then g_env_ov = alloc(g_env_ov_max)
        nl = 0
        while get_byte(name, nl) != 0 do nl = nl + 1 end
        vl = 0
        while get_byte(value, vl) != 0 do vl = vl + 1 end
        if g_env_ov_len + nl + vl + 2 > g_env_ov_max then false
        else do
            p = g_env_ov_len
            i = 0
            while i < nl do
                set_byte(g_env_ov, p, get_byte(name, i))
                p = p + 1
                i = i + 1
            end
            set_byte(g_env_ov, p, 61)                 // '='
            p = p + 1
            i = 0
            while i < vl do
                set_byte(g_env_ov, p, get_byte(value, i))
                p = p + 1
                i = i + 1
            end
            set_byte(g_env_ov, p, 0)
            g_env_ov_len = p + 1
            true
        end
    end else do
        env_init()
        if g_env_sv == 0 then false
        else if call_dll(g_env_sv, name, value) != 0 then true else false
    end
end

env_init() do
    if is_linux() then env_linux_load()
    else if g_env_k32 == 0 then do
        g_env_k32 = load_dll("kernel32.dll")
        if g_env_k32 != 0 then do
            g_env_gv = get_fn(g_env_k32, "GetEnvironmentVariableA")
            g_env_sv = get_fn(g_env_k32, "SetEnvironmentVariableA")
        end
    end
    0
end
