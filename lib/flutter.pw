Switch(is_active: bool, action_id: i64): Widget do
    Widget(W_SWITCH, 40, 20, 0, 0,
           if is_active then FL_PRIMARY_R else FL_CARD_R,
           if is_active then FL_PRIMARY_G else FL_CARD_G,
           if is_active then FL_PRIMARY_B else FL_CARD_B,
           FL_CARD_BORDER_R, FL_CARD_BORDER_G, FL_CARD_BORDER_B, 10,
           "", 1, 0, 0, 0, 0,
           0, 0, action_id, if is_active then 1 else 0, 0, 0, 0, 0, 40, 20)
end

Checkbox(is_checked: bool, label: string, action_id: i64): Widget do
    tw = if _str_len(label) > 0 then 24 + gui_text_width(label, 1) else 18
    Widget(W_CHECKBOX, tw, 20, 0, 0,
           FL_CARD_R, FL_CARD_G, FL_CARD_B, FL_CARD_BORDER_R, FL_CARD_BORDER_G, FL_CARD_BORDER_B, 2,
           label, 1, FL_TEXT_R, FL_TEXT_G, FL_TEXT_B, 0,
           0, 0, action_id, if is_checked then 1 else 0, 0, 0, 0, 0, tw, 20)
end

Slider(val: i64, min_v: i64, max_v: i64, action_id: i64): Widget do
