           FL_CARD_R, FL_CARD_G, FL_CARD_B, FL_CARD_BORDER_R, FL_CARD_BORDER_G, FL_CARD_BORDER_B, 0,
           "", 1, 0, 0, 0, 0,
           0, 0, action_id, val, min_v, max_v, 0, 0, 0, 28)
end

LinearProgressIndicator(pct: i64): Widget do
    Widget(W_PROGRESS, 0, 10, 0, 0,
           FL_CARD_R, FL_CARD_G, FL_CARD_B, FL_CARD_BORDER_R, FL_CARD_BORDER_G, FL_CARD_BORDER_B, 0,
           "", 1, 0, 0, 0, 0,
           0, 0, 0, if pct < 0 then 0 else if pct > 100 then 100 else pct, 0, 100, 0, 0, 0, 10)
end

CupertinoButton(label: string, action_id: i64): Widget do
    Widget(W_CUPERTINO_BTN, 0, 34, 0, 0,
           FL_PRIMARY_R, FL_PRIMARY_G, FL_PRIMARY_B, FL_PRIMARY_HOVER_R, FL_PRIMARY_HOVER_G, FL_PRIMARY_HOVER_B, 8,
           label, 1, 255, 255, 255, 0,
           0, 0, action_id, 0, 0, 0, 0, 0, 0, 34)
end

// ------------------------------------------------------------
// 6. Flutter Flexbox Layout Engine (Two-Pass: Measure & Layout)
// ------------------------------------------------------------
fl_measure(w: Widget, parent_w: i64, parent_h: i64) do
    if w.kind == W_SIZED_BOX do
        w.measured_w = w.w
        w.measured_h = w.h
    else if w.kind == W_TEXT or w.kind == W_ICON or w.kind == W_PROGRESS or w.kind == W_SWITCH or w.kind == W_CHECKBOX or w.kind == W_SLIDER or w.kind == W_ELEV_BTN or w.kind == W_OUTL_BTN or w.kind == W_TEXT_BTN or w.kind == W_CUPERTINO_BTN or w.kind == W_FAB or w.kind == W_PLACEHOLDER do
        w.measured_w = if w.w > 0 then w.w else parent_w
        w.measured_h = w.h
    else if w.kind == W_CONTAINER or w.kind == W_SAFE_AREA or w.kind == W_CARD do
        inner_w = parent_w - w.pad * 2
        inner_h = parent_h - w.pad * 2
        if w.child != 0 do
            fl_measure(w.child, inner_w, inner_h)
            w.measured_w = parent_w
            w.measured_h = w.child.measured_h + w.pad * 2
        else do
            w.measured_w = parent_w
            w.measured_h = w.pad * 2
        end
    else if w.kind == W_LIST_TILE do
        w.measured_w = parent_w
        w.measured_h = if w.h > 0 then w.h else 42
        if w.child != 0 do
            fl_measure(w.child, 16, 16)
        end
        if w.children != 0 and size(w.children) > 0 do
            tr = w.children[0]
            if tr != 0 do
                fl_measure(tr, tr.w, tr.h)
            end
        end
    else if w.kind == W_COLUMN do
        total_h = 0
        if w.children != 0 do
            cnt = size(w.children)
            i = 0
            while i < cnt do
                ch = w.children[i]
                if ch.kind != W_EXPANDED do
                    fl_measure(ch, parent_w, parent_h)
                    total_h += ch.measured_h
                end
                i += 1
            end
            
            // Flex expansion pass for Expanded widgets in Column
            rem_h = parent_h - total_h
            if rem_h < 0 do rem_h = 0 end
            total_flex = 0
            i = 0
            while i < cnt do
                ch = w.children[i]
                if ch.kind == W_EXPANDED do total_flex += ch.flex end
                i += 1
            end
            
            i = 0
            while i < cnt do
                ch = w.children[i]
                if ch.kind == W_EXPANDED do
                    alloc_h = if total_flex > 0 then (rem_h * ch.flex) / total_flex else 0
                    if ch.child != 0 do
                        fl_measure(ch.child, parent_w, alloc_h)
                        ch.measured_w = parent_w
                        ch.measured_h = alloc_h
                    end
                    total_h += alloc_h
                end
                i += 1
            end
        end
        w.measured_w = parent_w
        w.measured_h = total_h
    else if w.kind == W_ROW do
        total_w = 0
        max_h = 0
        if w.children != 0 do
            cnt = size(w.children)
            i = 0
            while i < cnt do
                ch = w.children[i]
                if ch.kind != W_EXPANDED do
                    fl_measure(ch, parent_w, parent_h)
                    total_w += ch.measured_w
                    if ch.measured_h > max_h do max_h = ch.measured_h end
                end
                i += 1
            end
            
            // Flex expansion pass for Expanded widgets in Row
            rem_w = parent_w - total_w
            if rem_w < 0 do rem_w = 0 end
            total_flex = 0
            i = 0
            while i < cnt do
                ch = w.children[i]
                if ch.kind == W_EXPANDED do total_flex += ch.flex end
                i += 1
            end
            
            i = 0
            while i < cnt do
                ch = w.children[i]
                if ch.kind == W_EXPANDED do
                    alloc_w = if total_flex > 0 then (rem_w * ch.flex) / total_flex else 0
                    if ch.child != 0 do
                        fl_measure(ch.child, alloc_w, parent_h)
                        ch.measured_w = alloc_w
                        ch.measured_h = ch.child.measured_h
                        if ch.measured_h > max_h do max_h = ch.measured_h end
                    end
                    total_w += alloc_w
                end
                i += 1
            end
        end
        w.measured_w = parent_w
        w.measured_h = max_h
    else if w.kind == W_SCAFFOLD do
        w.measured_w = parent_w
        w.measured_h = parent_h
        if w.child != 0 do
            fl_measure(w.child, parent_w - 32, parent_h - 60)
        end
    end
    0
end

fl_layout(w: Widget, origin_x: i64, origin_y: i64) do
    w.layout_x = origin_x
    w.layout_y = origin_y
    
    if w.kind == W_CONTAINER or w.kind == W_SAFE_AREA or w.kind == W_CARD do
        if w.child != 0 do
            fl_layout(w.child, origin_x + w.pad, origin_y + w.pad)
        end
    else if w.kind == W_LIST_TILE do
        if w.child != 0 do
            w.child.measured_w = 12
            w.child.measured_h = 12
            fl_layout(w.child, origin_x + 8, origin_y + (w.measured_h - 12) / 2)
        end
        if w.children != 0 and size(w.children) > 0 do
            tr = w.children[0]
            if tr != 0 do
                fl_layout(tr, origin_x + w.measured_w - tr.measured_w - 8, origin_y + (w.measured_h - tr.measured_h) / 2)
            end
        end
    else if w.kind == W_EXPANDED do
        if w.child != 0 do
            w.child.measured_w = w.measured_w
            w.child.measured_h = w.measured_h
            fl_layout(w.child, origin_x, origin_y)
        end
    else if w.kind == W_COLUMN do
        cur_y = origin_y
        if w.children != 0 do
            cnt = size(w.children)
            i = 0
            while i < cnt do
                ch = w.children[i]
                fl_layout(ch, origin_x, cur_y)
                cur_y += ch.measured_h
                i += 1
            end
        end
    else if w.kind == W_ROW do
        cur_x = origin_x
        if w.children != 0 do
            cnt = size(w.children)
            i = 0
            while i < cnt do
                ch = w.children[i]
                fl_layout(ch, cur_x, origin_y)
                cur_x += ch.measured_w
                i += 1
            end
        end
    else if w.kind == W_SCAFFOLD do
        // Layout AppBar
        if w.children != 0 do
            app_bar = w.children[0]
            if app_bar != 0 do
                app_bar.measured_w = w.measured_w
                fl_layout(app_bar, origin_x, origin_y)
            end
            
            // Layout Body
            if w.child != 0 do
                fl_layout(w.child, origin_x + 16, origin_y + 54)
            end
            
            // Layout FAB (Floating Action Button at bottom right)
            fab = w.children[1]
            if fab != 0 do
                fab_x = origin_x + w.measured_w - 64
                fab_y = origin_y + w.measured_h - 64
                fl_layout(fab, fab_x, fab_y)
            end
        end
    end
    0
end

// ------------------------------------------------------------
// 7. Pass 1: Render All Canvas Backgrounds, Boxes, and Icons
// ------------------------------------------------------------
fl_render_canvas_pass(app: FlutterApp, w: Widget): i64 do
    triggered_action = 0
    x = w.layout_x
    y = w.layout_y
    mw = w.measured_w
    mh = w.measured_h
    
    mx = app.mouse_x
    my = app.mouse_y
    is_hover = if mx >= x and mx < x + mw and my >= y and my < y + mh then true else false
    is_clicked = if app.clicked == 1 and app.click_x >= x and app.click_x < x + mw and app.click_y >= y and app.click_y < y + mh then true else false
    
    if w.kind == W_CONTAINER or w.kind == W_CARD do
        canvas_draw_rect(app.canvas, x, y, mw, mh, w.bg_r, w.bg_g, w.bg_b, 255, 1)
        if w.radius > 0 do
            canvas_draw_rect(app.canvas, x, y, mw, mh, w.border_r, w.border_g, w.border_b, 255, 0)
        end
        if w.child != 0 do
            act = fl_render_canvas_pass(app, w.child)
            if act != 0 do triggered_action = act end
        end
    else if w.kind == W_ICON do
        fl_draw_icon(app.canvas, w.icon_id, x + 2, y + 2, w.text_r, w.text_g, w.text_b)
    else if w.kind == W_ELEV_BTN or w.kind == W_CUPERTINO_BTN do
        btn_r = if is_hover then w.border_r else w.bg_r
        btn_g = if is_hover then w.border_g else w.bg_g
        btn_b = if is_hover then w.border_b else w.bg_b
        canvas_draw_rect(app.canvas, x, y, mw, mh, btn_r, btn_g, btn_b, 255, 1)
        if is_hover do
            canvas_draw_rect(app.canvas, x, y, mw, mh, 255, 255, 255, 255, 0)
        end
        if is_clicked do triggered_action = w.action_id end
    else if w.kind == W_OUTL_BTN do
        bg_r = if is_hover then FL_CARD_BORDER_R else FL_CARD_R
        bg_g = if is_hover then FL_CARD_BORDER_G else FL_CARD_G
        bg_b = if is_hover then FL_CARD_BORDER_B else FL_CARD_B
        canvas_draw_rect(app.canvas, x, y, mw, mh, bg_r, bg_g, bg_b, 255, 1)
        canvas_draw_rect(app.canvas, x, y, mw, mh, if is_hover then FL_PRIMARY_R else FL_CARD_BORDER_R, if is_hover then FL_PRIMARY_G else FL_CARD_BORDER_G, if is_hover then FL_PRIMARY_B else FL_CARD_BORDER_B, 255, 0)
        if is_clicked do triggered_action = w.action_id end
    else if w.kind == W_TEXT_BTN do
        if is_clicked do triggered_action = w.action_id end
    else if w.kind == W_FAB do
        canvas_draw_rect(app.canvas, x, y, mw, mh, if is_hover then w.border_r else w.bg_r, if is_hover then w.border_g else w.bg_g, if is_hover then w.border_b else w.bg_b, 255, 1)
        canvas_draw_rect(app.canvas, x, y, mw, mh, 255, 255, 255, 255, 0)
        if w.child != 0 do
            w.child.layout_x = x + (mw - 12) / 2
            w.child.layout_y = y + (mh - 12) / 2
            act = fl_render_canvas_pass(app, w.child)
            if act != 0 do triggered_action = act end
        end
        if is_clicked do triggered_action = w.action_id end
    else if w.kind == W_APP_BAR do
        canvas_draw_rect(app.canvas, x, y, mw, mh, w.bg_r, w.bg_g, w.bg_b, 255, 1)
        canvas_draw_line(app.canvas, x, y + mh - 1, x + mw, y + mh - 1, w.border_r, w.border_g, w.border_b, 255)
        if w.children != 0 do
            ax = x + mw - 32
            cnt = size(w.children)
            i = 0
            while i < cnt do
                act_w = w.children[i]
                act_w.layout_x = ax
                act_w.layout_y = y + 14
                act = fl_render_canvas_pass(app, act_w)
                if act != 0 do triggered_action = act end
                ax -= 28
                i += 1
            end
        end
    else if w.kind == W_LIST_TILE do
        canvas_draw_rect(app.canvas, x, y, mw, mh, if is_hover then FL_CARD_BORDER_R else w.bg_r, if is_hover then FL_CARD_BORDER_G else w.bg_g, if is_hover then FL_CARD_BORDER_B else w.bg_b, 255, 1)
        if w.child != 0 do
            act = fl_render_canvas_pass(app, w.child)
            if act != 0 do triggered_action = act end
        end
        if w.children != 0 and size(w.children) > 0 do
            tr = w.children[0]
            if tr != 0 do
                act = fl_render_canvas_pass(app, tr)
                if act != 0 do triggered_action = act end
            end
        end
        if is_clicked do triggered_action = w.action_id end
    else if w.kind == W_SWITCH do
        sw_w = w.measured_w
        sw_h = w.measured_h
        bg_r = if w.val_i64 == 1 then FL_PRIMARY_R else FL_CARD_BORDER_R
        bg_g = if w.val_i64 == 1 then FL_PRIMARY_G else FL_CARD_BORDER_G
        bg_b = if w.val_i64 == 1 then FL_PRIMARY_B else FL_CARD_BORDER_B
        canvas_draw_rect(app.canvas, x, y, sw_w, sw_h, bg_r, bg_g, bg_b, 255, 1)
        canvas_draw_rect(app.canvas, x, y, sw_w, sw_h, 255, 255, 255, 255, 0)
        knob_x = if w.val_i64 == 1 then x + sw_w - 18 else x + 2
        canvas_draw_rect(app.canvas, knob_x, y + 2, 16, 16, 255, 255, 255, 255, 1)
        if is_clicked do triggered_action = w.action_id end
    else if w.kind == W_CHECKBOX do
        cb_sz = 16
        cy = y + (mh - cb_sz) / 2
        canvas_draw_rect(app.canvas, x, cy, cb_sz, cb_sz, FL_CARD_R, FL_CARD_G, FL_CARD_B, 255, 1)
        canvas_draw_rect(app.canvas, x, cy, cb_sz, cb_sz, if is_hover then FL_PRIMARY_R else FL_CARD_BORDER_R, if is_hover then FL_PRIMARY_G else FL_CARD_BORDER_G, if is_hover then FL_PRIMARY_B else FL_CARD_BORDER_B, 255, 0)
        if w.val_i64 == 1 do
            canvas_draw_rect(app.canvas, x + 3, cy + 3, cb_sz - 6, cb_sz - 6, FL_PRIMARY_R, FL_PRIMARY_G, FL_PRIMARY_B, 255, 1)
        end
        if is_clicked do triggered_action = w.action_id end
    else if w.kind == W_SLIDER do
        th = 8
        ty = y + 10
        canvas_draw_rect(app.canvas, x, ty, mw, th, FL_CARD_R, FL_CARD_G, FL_CARD_B, 255, 1)
        canvas_draw_rect(app.canvas, x, ty, mw, th, FL_CARD_BORDER_R, FL_CARD_BORDER_G, FL_CARD_BORDER_B, 255, 0)
        range = if w.max_val - w.min_val <= 0 then 1 else w.max_val - w.min_val
        val = if w.val_i64 < w.min_val then w.min_val else if w.val_i64 > w.max_val then w.max_val else w.val_i64
        fill_w = (mw * (val - w.min_val)) / range
        if fill_w > 0 do
            canvas_draw_rect(app.canvas, x + 1, ty + 1, fill_w, th - 2, FL_PRIMARY_R, FL_PRIMARY_G, FL_PRIMARY_B, 255, 1)
        end
        kx = x + fill_w - 4
        if kx < x do kx = x end
        if kx + 8 > x + mw do kx = x + mw - 8 end
        canvas_draw_rect(app.canvas, kx, ty - 2, 8, th + 4, 255, 255, 255, 255, 1)
        
        if app.mouse_down and mx >= x and mx <= x + mw and my >= ty - 6 and my <= ty + th + 6 do
            pct = (mx - x) * 100 / mw
            new_val = w.min_val + (range * pct) / 100
            if new_val < w.min_val do new_val = w.min_val end
            if new_val > w.max_val do new_val = w.max_val end
            app.active_slider_action = w.action_id
            app.slider_val = new_val
            triggered_action = w.action_id
        end
    else if w.kind == W_PROGRESS do
        canvas_draw_rect(app.canvas, x, y, mw, mh, FL_CARD_R, FL_CARD_G, FL_CARD_B, 255, 1)
        canvas_draw_rect(app.canvas, x, y, mw, mh, FL_CARD_BORDER_R, FL_CARD_BORDER_G, FL_CARD_BORDER_B, 255, 0)
        fill_w = ((mw - 4) * w.val_i64) / 100
        if fill_w > 0 do
            canvas_draw_rect(app.canvas, x + 2, y + 2, fill_w, mh - 4, FL_SUCCESS_R, FL_SUCCESS_G, FL_SUCCESS_B, 255, 1)
        end
    else if w.kind == W_COLUMN or w.kind == W_ROW or w.kind == W_STACK do
        if w.children != 0 do
            cnt = size(w.children)
            i = 0
            while i < cnt do
                ch = w.children[i]
                act = fl_render_canvas_pass(app, ch)
                if act != 0 do triggered_action = act end
                i += 1
            end
        end
    else if w.kind == W_EXPANDED do
        if w.child != 0 do
            act = fl_render_canvas_pass(app, w.child)
            if act != 0 do triggered_action = act end
        end
    else if w.kind == W_SCAFFOLD do
        canvas_clear(app.canvas, w.bg_r, w.bg_g, w.bg_b, 255)
        if w.children != 0 do
            app_bar = w.children[0]
            if app_bar != 0 do
                act = fl_render_canvas_pass(app, app_bar)
                if act != 0 do triggered_action = act end
            end
        end
        if w.child != 0 do
            act = fl_render_canvas_pass(app, w.child)
            if act != 0 do triggered_action = act end
        end
        if w.children != 0 do
            fab = w.children[1]
            if fab != 0 do
                act = fl_render_canvas_pass(app, fab)
                if act != 0 do triggered_action = act end
            end
        end
    end
    
    triggered_action
end

// ------------------------------------------------------------
// 8. Pass 2: Render All Native ClearType Text Directly on Memory DC
// ------------------------------------------------------------
fl_render_text_pass(app: FlutterApp, w: Widget) do
    x = w.layout_x
    y = w.layout_y
    mw = w.measured_w
    mh = w.measured_h
    
    mx = app.mouse_x
    my = app.mouse_y
    is_hover = if mx >= x and mx < x + mw and my >= y and my < y + mh then true else false

    if w.kind == W_TEXT do
        gui_draw_text(app.win, w.text, x, y + (mh - 16) / 2, w.text_size, w.text_r, w.text_g, w.text_b)
    else if w.kind == W_ELEV_BTN or w.kind == W_OUTL_BTN or w.kind == W_CUPERTINO_BTN do
        tw = gui_text_width(w.text, w.text_size)
        tx = x + (mw - tw) / 2
        ty = y + (mh - 16) / 2
        gui_draw_text(app.win, w.text, tx, ty, w.text_size, w.text_r, w.text_g, w.text_b)
    else if w.kind == W_TEXT_BTN do
        tw = gui_text_width(w.text, w.text_size)
        tx = x + (mw - tw) / 2
        ty = y + (mh - 16) / 2
        txt_r = if is_hover then 255 else w.text_r
        txt_g = if is_hover then 255 else w.text_g
        txt_b = if is_hover then 255 else w.text_b
        gui_draw_text(app.win, w.text, tx, ty, w.text_size, txt_r, txt_g, txt_b)
    else if w.kind == W_APP_BAR do
        gui_draw_text(app.win, w.text, x + 16, y + 10, w.text_size, w.text_r, w.text_g, w.text_b)
        if w.children != 0 do
            cnt = size(w.children)
            i = 0
            while i < cnt do
                fl_render_text_pass(app, w.children[i])
                i += 1
            end
        end
    else if w.kind == W_LIST_TILE do
        tx = x + 8
        if w.child != 0 do
            tx += 22
        end
        gui_draw_text(app.win, w.text, tx, y + (mh - 16) / 2, 1, w.text_r, w.text_g, w.text_b)
        if w.children != 0 and size(w.children) > 0 do
            tr = w.children[0]
            if tr != 0 do
                fl_render_text_pass(app, tr)
            end
        end
    else if w.kind == W_CHECKBOX do
        cb_sz = 16
        if _str_len(w.text) > 0 do
            gui_draw_text(app.win, w.text, x + cb_sz + 8, y + (mh - 16) / 2, 1, w.text_r, w.text_g, w.text_b)
        end
    else if w.kind == W_CONTAINER or w.kind == W_CARD or w.kind == W_SAFE_AREA or w.kind == W_EXPANDED do
        if w.child != 0 do
            fl_render_text_pass(app, w.child)
        end
    else if w.kind == W_COLUMN or w.kind == W_ROW or w.kind == W_STACK do
        if w.children != 0 do
            cnt = size(w.children)
            i = 0
            while i < cnt do
                fl_render_text_pass(app, w.children[i])
                i += 1
            end
        end
    else if w.kind == W_SCAFFOLD do
        if w.children != 0 do
            app_bar = w.children[0]
            if app_bar != 0 do
                fl_render_text_pass(app, app_bar)
            end
        end
        if w.child != 0 do
            fl_render_text_pass(app, w.child)
        end
    end
    0
end

// ------------------------------------------------------------
// 9. Flutter Application Lifecycle & Runner
// ------------------------------------------------------------
flutter_app(title: string, width: i64, height: i64): FlutterApp do
    w = gui_open_window(title, width, height)
    c = canvas_create(width, height)
    FlutterApp(w, c, width, height,
               0, 0, 0, 0, 0, 0,
               "", 0, 0, 0)
end

flutter_running(app: FlutterApp): bool do
    if app.win == 0 then false
    else if gui_is_open(app.win) == 0 then false
    else if gui_key_esc(app.win) then false
    else true
end

flutter_slider_val(app: FlutterApp): i64 do
    app.slider_val
end

flutter_render(app: FlutterApp, root: Widget): i64 do
    gui_poll_events(app.win)
    app.mouse_x = gui_mouse_x(app.win)
    app.mouse_y = gui_mouse_y(app.win)
    app.mouse_down = gui_mouse_down(app.win)
    
    if gui_click_pending(app.win) > 0 do
        app.clicked = 1
        app.click_x = app.win.click_x
        app.click_y = app.win.click_y
        app.win.click_cnt = 0
    else do
        app.clicked = 0
        app.click_x = 0
        app.click_y = 0
    end

    // Pass 1: Measure Tree
    fl_measure(root, app.width, app.height)

    // Pass 2: Layout Coordinates
    fl_layout(root, 0, 0)

    // Pass 3: Render All Canvas Backgrounds, Boxes, and Icons
    act = fl_render_canvas_pass(app, root)

    // Render SnackBar Box if active
    if app.snackbar_frames > 0 do
        sb_h = 36
        sb_y = app.height - sb_h - 16
        sb_w = app.width - 32
        canvas_draw_rect(app.canvas, 16, sb_y, sb_w, sb_h, 30, 41, 59, 240, 1)
        canvas_draw_rect(app.canvas, 16, sb_y, sb_w, sb_h, FL_PRIMARY_R, FL_PRIMARY_G, FL_PRIMARY_B, 255, 0)
    end

    // Pass 4: Blit Complete Canvas to Memory DC (ONCE)
    gui_blit_canvas(app.win, app.canvas)

    // Pass 5: Render All Native ClearType Text Directly on Memory DC
    fl_render_text_pass(app, root)

    // Render SnackBar text on top of Memory DC if active
    if app.snackbar_frames > 0 do
        sb_h = 36
        sb_y = app.height - sb_h - 16
        gui_draw_text(app.win, app.snackbar_text, 28, sb_y + 10, 1, 255, 255, 255)
        app.snackbar_frames -= 1
    end

    // Pass 6: Hardware Flip to Screen (Single BitBlt)
    gui_flip_buffer(app.win)
    
    act
end

flutter_show_snackbar(app: FlutterApp, text: string) do
    app.snackbar_text = text
    app.snackbar_frames = 90 // ~1.5 seconds at 60fps
    0
end

flutter_close(app: FlutterApp) do
    canvas_destroy(app.canvas)
    gui_close_window(app.win)
    drop(app)
    0
end
